---
import repoInfo from '../data/repo-info.json';
import { footerColumns, localeLabels, site } from '../data/site';
import { url } from '../utils/paths';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
const localeCount = repoInfo.locales.length;
---

<footer class="site-footer bg-slate-950 text-slate-400 text-sm mt-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-8 lg:gap-10">
      <div class="lg:col-span-2">
        <a href={url('/')} class="inline-flex mb-4" aria-label="AutoTelegramForward home">
          <Logo />
        </a>
        <p class="text-slate-400 text-sm leading-relaxed max-w-md mb-5">
          Self-hosted Telegram routing: many sources to many targets, per-task content rules, optional AI rewriting,
          durable ordered delivery and a fail-closed multi-tenant control plane.
        </p>
        <ul class="flex flex-wrap items-center gap-2 text-xs text-slate-400 mb-5 list-none p-0">
          <li class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-900 border border-slate-800 text-slate-300">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            v{repoInfo.version} · {repoInfo.gitCommit}
          </li>
          <li class="px-2.5 py-1 rounded-full bg-slate-900 border border-slate-800 text-slate-300">MIT license</li>
          <li class="px-2.5 py-1 rounded-full bg-slate-900 border border-slate-800 text-slate-300">{localeCount} languages</li>
          <li class="px-2.5 py-1 rounded-full bg-slate-900 border border-slate-800 text-slate-300">{site.stats.services} services</li>
        </ul>
        <div class="flex flex-wrap gap-2">
          <a
            href={url('/getting-started/')}
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg text-xs font-semibold bg-tg-blue hover:bg-sky-500 text-white transition-colors"
          >
            <Icon name="download" class="w-3.5 h-3.5" />
            Install
          </a>
          <a
            href={repoInfo.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg text-xs font-semibold bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-200 transition-colors"
          >
            <Icon name="github" class="w-3.5 h-3.5" />
            Source
          </a>
        </div>
      </div>

      {
        footerColumns.map((column) => (
          <nav aria-label={column.title}>
            <p class="footer-heading text-white font-semibold text-xs uppercase tracking-wider mb-3">{column.title}</p>
            <ul class="space-y-2 list-none p-0 m-0">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="hover:text-white transition-colors"
                    {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-10 pt-8 border-t border-slate-900/80">
      <p class="footer-heading text-white font-semibold text-xs uppercase tracking-wider mb-3">Interface languages</p>
      <ul class="flex flex-wrap gap-2 text-xs list-none p-0 m-0">
        {
          repoInfo.locales.map((code: string) => {
            const meta = localeLabels[code];
            return (
              <li class="px-2.5 py-1 rounded-md bg-slate-900/70 border border-slate-800 text-slate-300" dir={meta?.rtl ? 'rtl' : 'ltr'}>
                {meta?.native ?? code}
                <span class="text-slate-500 font-mono ml-1.5">{code}</span>
              </li>
            );
          })
        }
      </ul>
    </div>

    <div class="mt-10 pt-8 border-t border-slate-900/80 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-slate-400">
      <p class="m-0">
        © {year} Opselon. Released under the open-source MIT license.
        <span class="block mt-1 font-mono text-[11px] text-slate-500">
          Built from v{repoInfo.version} · commit {repoInfo.gitCommit} · content synced {repoInfo.syncTimestamp.slice(0, 10)}
        </span>
      </p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href={url('/architecture/')} class="hover:text-slate-200">Architecture</a>
        <a href={url('/security/')} class="hover:text-slate-200">Security</a>
        <a href={url('/status/')} class="hover:text-slate-200">Status</a>
        <a href={url('/operations/troubleshooting/')} class="hover:text-slate-200">Troubleshooting</a>
        <a href={url('/api/')} class="hover:text-slate-200">API</a>
        <a href={url('/cli/')} class="hover:text-slate-200">CLI</a>
        <a href={repoInfo.maintainer.url} target="_blank" rel="noopener noreferrer" class="hover:text-slate-200">
          {repoInfo.maintainer.handle}
        </a>
        <a href={`${repoInfo.repoUrl}/issues`} target="_blank" rel="noopener noreferrer" class="hover:text-slate-200">Issues</a>
      </div>
    </div>
  </div>
</footer>
