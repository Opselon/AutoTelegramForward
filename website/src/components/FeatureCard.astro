---
import Icon from './Icon.astro';

interface Props {
  title: string;
  desc: string;
  href: string;
  icon?: string;
  badge?: string;
  isNew?: boolean;
  external?: boolean;
  class?: string;
}

const { title, desc, href, icon = 'sparkles', badge, isNew = false, external = false, class: cls = '' } = Astro.props;
---

<a
  href={href}
  class={`feature-card ${cls}`}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <span class="feature-card-top">
    <span class="feature-card-icon">
      <Icon name={icon} class="w-[18px] h-[18px]" strokeWidth={2} />
    </span>
    {badge && <span class={`feature-card-badge ${isNew ? 'is-new' : ''}`}>{badge}</span>}
  </span>
  <span class="feature-card-title">{title}</span>
  <span class="feature-card-desc">{desc}</span>
  <span class="feature-card-cta">
    Read more
    <Icon name="arrow-right" class="w-3.5 h-3.5" strokeWidth={2.4} />
  </span>
</a>
