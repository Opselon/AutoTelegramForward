  ['<code>endpoint_invalid</code> / <code>endpoint_blocked</code>', 'The URL is not plain <code>http(s)</code>, or the guard refused the host — see the guard table below.'],
  ['<code>endpoint_unreachable</code>', 'The connection failed, or the name did not resolve. Only the exception\u2019s type name is reported: a connection message can carry an internal host.'],
