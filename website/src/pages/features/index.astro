---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CapabilityMatrix from '../../components/CapabilityMatrix.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import Callout from '../../components/Callout.astro';
import SpecTable from '../../components/SpecTable.astro';
import Icon from '../../components/Icon.astro';
import StatusBoard from '../../components/StatusBoard.astro';
import { featureHub, featurePages } from '../../data/features';
import repoInfo from '../../data/repo-info.json';
import { url } from '../../utils/paths';

const pageTitle = 'Features & Capabilities';
const pageDesc =
  'Every verified capability: multi-source routing, per-task content rules, AI rewriting, ordered delivery, observability, ten-language UI and DevOps tooling.';

const toc = [
  { id: 'new', title: 'New in v2.0' },
  { id: 'status', title: 'Implemented, partial, planned' },
  { id: 'deep-dives', title: 'All features' },
  { id: 'matrix', title: 'Capability parity' },
  { id: 'capabilities', title: 'Verified capability list' },
  { id: 'shortcodes', title: 'Shortcode reference' },
];
---

<DocsLayout
  title={pageTitle}
  description={pageDesc}
  path="/features/"
  breadcrumbs={[
    { name: 'Home', href: url('/') },
    { name: 'Features', href: url('/features/') },
  ]}
  toc={toc}
  itemList={{
    name: 'AutoTelegramForward capabilities',
    items: featurePages.map((feature) => ({
      name: feature.cardTitle,
      description: feature.description,
      url: `/features/${feature.slug}/`,
    })),
  }}
>
  <p>
    AutoTelegramForward routes messages between Telegram chats: it reads from source chats you authorize, decides what
    should go out, rewrites what needs rewriting, and delivers it durably to one or many targets. This page lists every
    capability, grouped by the subsystem that owns it.
  </p>

  <StatusBoard />

  <section class="not-prose scroll-mt-24" id="new">
    <h2 class="display-3 text-white mb-2 scroll-mt-24">New in v{repoInfo.version}</h2>
    <p class="m-0 mb-4 text-[15px] leading-relaxed text-slate-300">
      The nine deep dives below cover everything that changed in the v2.0 line — read them in order if you are upgrading
      from an older release.
    </p>
    <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
      {
        featureHub[0].items.map((item) => (
          <FeatureCard
            title={item.title}
            desc={item.desc}
            href={url(item.href)}
            icon={item.icon}
            badge={item.badge}
            isNew
          />
        ))
      }
    </div>
  </section>

  <section class="not-prose scroll-mt-24" id="deep-dives">
    <h2 class="display-3 text-white mb-3 scroll-mt-24">All features</h2>
    <div class="space-y-7">
      {
        featureHub.slice(1).map((group) => (
          <div>
            <h3 class="text-xs font-bold uppercase tracking-[0.14em] text-sky-400 mb-3">{group.group}</h3>
            <div class="grid gap-3.5 sm:grid-cols-2">
              {group.items.map((item) => (
                <FeatureCard title={item.title} desc={item.desc} href={url(item.href)} icon={item.icon} badge={item.badge} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="not-prose scroll-mt-24" id="matrix">
    <h2 class="display-3 text-white mb-3 scroll-mt-24">Capability parity</h2>
    <CapabilityMatrix
      title="Same capabilities, four clients"
      subtitle="Bot UI, dashboard, mobile app and the REST API are checked against each other, not just documented."
    />
  </section>

  <section class="not-prose scroll-mt-24" id="capabilities">
    <h2 class="display-3 text-white mb-2 scroll-mt-24">Verified capability list</h2>
    <p class="m-0 mb-4 text-[15px] text-slate-300">
      Generated from the checkout at build time ({repoInfo.stats.featureCatalogEntries} catalogued behaviours,{' '}
      {repoInfo.stats.grpcRpcCount} gRPC methods, {repoInfo.stats.cliGroups} CLI command groups).
    </p>

    <div class="grid gap-4 lg:grid-cols-2">
      {
        repoInfo.verifiedFeatures.map((group: { category: string; items: string[] }) => (
          <div class="card">
            <h3 class="text-sm font-bold text-white mb-3 flex items-center gap-2">
              <Icon name="check" class="w-4 h-4 text-emerald-400" strokeWidth={2.4} />
              {group.category}
            </h3>
            <ul class="grid gap-2 list-none p-0 m-0">
              {group.items.map((item) => (
                <li class="flex gap-2 text-[13.5px] leading-relaxed text-slate-300">
                  <span class="mt-[7px] w-1.5 h-1.5 rounded-full bg-sky-400/70 shrink-0"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <Callout type="success" class="mt-5" title="Why these lists exist">
      <p>
        Numbers on this site are read from the repository during the build — the version file, the locale catalog, the
        proto definitions and the CLI command modules. If the code changes without the site, the build changes with it.
      </p>
    </Callout>
  </section>

  <section class="not-prose scroll-mt-24" id="shortcodes">
    <h2 class="display-3 text-white mb-3 scroll-mt-24">Shortcode reference</h2>
    <SpecTable
      headers={['Shortcode', 'Meaning', 'Rendered example']}
      rows={repoInfo.supportedShortcodes.map((item: { code: string; desc: string; example: string }) => [
        `<code>${item.code}</code>`,
        item.desc,
        `<code>${item.example}</code>`,
      ])}
      caption="Twelve validated shortcodes, interpolated per delivery"
    />

    <div class="mt-6 card">
      <h3 class="text-sm font-bold text-white mb-2">Want to see them rendered?</h3>
      <p class="m-0 mb-3 text-[13.5px] text-slate-400">
        The playground runs the cleaner, the shortcode interpolation and the delivery preview entirely in your browser.
      </p>
      <a href={url('/tools/playground/')} class="btn btn-primary btn-sm">
        Open the playground
        <Icon name="arrow-right" class="w-3.5 h-3.5" />
      </a>
    </div>
  </section>
</DocsLayout>
