---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { docsNav, docsOrder, allDocLinks } from '../data/docs-nav';
import repoInfo from '../data/repo-info.json';
import { url } from '../utils/paths';

interface Props {
  title: string;
  /** Visible H1 when the SEO title needs more context than a heading should carry. */
  heading?: string;
  description: string;
  breadcrumbs: Array<{ name: string; href?: string }>;
  /** Path of this page, base-less, e.g. "/features/text-cleaner/". Used for sidebar state and paging. */
  path?: string;
  activeSlug?: string;
  toc?: Array<{ id: string; title: string }>;
  prev?: { title: string; href: string };
  next?: { title: string; href: string };
  /** Optional page-level extra SEO payloads forwarded to the layout. */
  faq?: Array<{ q: string; a: string }>;
  keywords?: string[];
  itemList?: { name: string; items: Array<{ name: string; description: string; url: string }> };
  articleDate?: string;
}

const {
  title,
  heading,
  description,
  breadcrumbs,
  path,
  toc = [],
  prev,
  next,
  faq,
  keywords,
  itemList,
  articleDate,
} = Astro.props;

const currentPath = Astro.url.pathname;
const normalise = (value: string) => {
  if (!value) return '/';
  const stripped = value.replace(/^https?:\/\/[^/]+/, '').replace(/\/$/, '');
  return stripped || '/';
};

// Strip the deployment base so a sidebar entry matches on any host/path.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const routeOf = (value: string) => {
  const clean = normalise(value);
  return base && clean.startsWith(base) ? normalise(clean.slice(base.length)) : clean;
};

const here = routeOf(path || currentPath);

const isCurrent = (itemPath: string) => {
  const target = normalise(itemPath.split('#')[0]);
  return target === here;
};

const isCategoryActive = (items: { path: string }[]) =>
  items.some((item) => {
    const target = normalise(item.path);
    return target === here || (target !== '/' && here.startsWith(`${target}/`));
  });

// Prev/next derived from the ordered docs list unless a page passes its own.
const fallbackIndex = docsOrder.indexOf(here);
const autoPrev =
  fallbackIndex > 0
    ? {
        title: allDocLinks[fallbackIndex - 1].title,
        href: url(allDocLinks[fallbackIndex - 1].path),
      }
    : undefined;
const autoNext =
  fallbackIndex >= 0 && fallbackIndex < docsOrder.length - 1
    ? {
        title: allDocLinks[fallbackIndex + 1].title,
        href: url(allDocLinks[fallbackIndex + 1].path),
      }
    : undefined;

const prevLink = prev ?? autoPrev;
const nextLink = next ?? autoNext;

/**
 * Related links are internal links a crawler can follow out of a leaf page and
 * a reader can actually want: the two neighbours either side of this entry in
 * the same navigation section, wrapping at the ends.
 */
const relatedSection = docsNav.find((section) =>
  section.items.some((item) => normalise(item.path) === here),
);
const related = (() => {
  if (!relatedSection) return [];
  const items = relatedSection.items;
  const index = items.findIndex((item) => normalise(item.path) === here);
  if (index < 0 || items.length < 3) return [];
  const picked: typeof items = [];
  for (const offset of [1, -1, 2, -2]) {
    const item = items[(index + offset + items.length) % items.length];
    if (item && normalise(item.path) !== here && !picked.includes(item)) picked.push(item);
    if (picked.length === 3) break;
  }
  return picked;
})();

const updatedLabel = (() => {
  const raw = repoInfo.gitDate;
  if (!raw) return '';
  const date = new Date(raw);
  return Number.isNaN(date.getTime())
    ? ''
    : date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
})();
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  breadcrumbs={breadcrumbs.map((b) => ({ name: b.name, url: b.href || '' }))}
  faq={faq}
  keywords={keywords}
  itemList={itemList}
  articleDate={articleDate}
>
  <div class="container-x py-5 sm:py-8">
    <Breadcrumbs items={breadcrumbs} />

    <div class="lg:grid lg:grid-cols-12 lg:gap-10 pt-4">
      <!-- Sidebar: desktop -->
      <aside class="hidden lg:block lg:col-span-3" aria-label="Documentation navigation">
        <div class="docs-sidebar space-y-6">
          {
            docsNav.map((section) => (
              <div>
                <p class="docs-nav-category">{section.category}</p>
                <ul class="space-y-0.5 list-none p-0 m-0">
                  {section.items.map((item) => (
                    <li>
                      <a
                        href={url(item.path)}
                        class={`docs-nav-link ${isCurrent(item.path) ? 'is-active' : ''}`}
                        aria-current={isCurrent(item.path) ? 'page' : undefined}
                      >
                        {item.title}
                        {item.isNew && <span class="docs-nav-badge">new</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </aside>

      <article class="lg:col-span-9 xl:col-span-7 max-w-none min-w-0">
        <!-- Mobile docs navigation -->
        <details class="lg:hidden mb-5 rounded-xl border border-slate-800 bg-slate-900/50">
          <summary class="flex items-center justify-between px-4 py-3 text-sm font-semibold text-slate-100">
            <span class="inline-flex items-center gap-2">
              <Icon name="book" class="w-4 h-4 text-sky-400" />
              Documentation menu
            </span>
            <Icon name="chevron-right" class="w-4 h-4 text-slate-500" />
          </summary>
          <div class="px-3 pb-4 space-y-4">
            {
              docsNav.map((section) => (
                <div>
                  <p class="docs-nav-category px-1">{section.category}</p>
                  <ul class="space-y-0.5 list-none p-0 m-0">
                    {section.items.map((item) => (
                      <li>
                        <a
                          href={url(item.path)}
                          class={`docs-nav-link ${isCurrent(item.path) ? 'is-active' : ''}`}
                          aria-current={isCurrent(item.path) ? 'page' : undefined}
                        >
                          {item.title}
                          {item.isNew && <span class="docs-nav-badge">new</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </details>

        <header class="article-head mb-7 pb-5 border-b border-slate-800">
          {
            isCategoryActive([{ path: here }]) && breadcrumbs.length > 0 && (
              <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.12em] text-sky-400">
                {breadcrumbs[breadcrumbs.length - 1].name}
              </p>
            )
          }
          <h1 class="display-2 text-white mb-3">{heading || title}</h1>
          <p class="text-base sm:text-lg text-slate-300 leading-relaxed">{description}</p>
          {updatedLabel && (
            <p class="mt-3 mb-0 text-xs text-slate-500 flex items-center gap-1.5">
              <Icon name="check" class="w-3.5 h-3.5 text-emerald-400" strokeWidth={2.4} />
              Verified against the checkout built for v{repoInfo.version} · updated {updatedLabel}
            </p>
          )}
        </header>

        <!-- On-page contents: inline on small screens, sticky column on XL -->
        {
          toc.length > 2 && (
            <details class="xl:hidden mb-6 rounded-xl border border-slate-800 bg-slate-900/40" open>
              <summary class="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-slate-400">On this page</summary>
              <ul class="px-3 pb-3 list-none m-0 space-y-0.5">
                {toc.map((item) => (
                  <li>
                    <a href={`#${item.id}`} class="toc-link">
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )
        }

        <div class="prose-custom max-w-none space-y-6">
          <slot />
        </div>

        {
          related.length > 0 && (
            <section aria-labelledby="related-heading" class="mt-12">
              <h2 id="related-heading" class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-400 mb-3">
                Related in this section
              </h2>
              <div class="related-grid">
                {related.map((item) => (
                  <a href={url(item.path)} class="related-link">
                    <span>{item.title}</span>
                    <span>{item.desc}</span>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        {
          (prevLink || nextLink) && (
            <nav aria-label="Page navigation" class="mt-12 pt-6 border-t border-slate-800 grid grid-cols-1 sm:grid-cols-2 gap-3">
              {prevLink ? (
                <a
                  href={prevLink.href}
                  class="prevnext-card p-4 border border-slate-800 bg-slate-900/40 group flex flex-col items-start min-h-[64px]"
                >
                  <span class="text-xs text-slate-400 font-medium flex items-center gap-1 group-hover:text-sky-400 transition-colors">
                    <Icon name="chevron-right" class="w-3.5 h-3.5 rotate-180" />
                    Previous
                  </span>
                  <span class="font-semibold text-slate-200 mt-1 text-sm">{prevLink.title}</span>
                </a>
              ) : (
                <span />
              )}

              {nextLink ? (
                <a
                  href={nextLink.href}
                  class="prevnext-card p-4 border border-slate-800 bg-slate-900/40 group flex flex-col items-end text-right min-h-[64px]"
                >
                  <span class="text-xs text-slate-400 font-medium flex items-center gap-1 group-hover:text-sky-400 transition-colors">
                    Next
                    <Icon name="chevron-right" class="w-3.5 h-3.5" />
                  </span>
                  <span class="font-semibold text-slate-200 mt-1 text-sm">{nextLink.title}</span>
                </a>
              ) : (
                <span />
              )}
            </nav>
          )
        }
      </article>

      <!-- On-page TOC: desktop XL -->
      {
        toc.length > 0 && (
          <aside class="hidden xl:block xl:col-span-2" aria-label="On this page">
            <div class="sticky top-24 pl-4">
              <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-3">On this page</p>
              <ul class="space-y-1.5 border-l border-slate-800 pl-3 list-none m-0">
                {toc.map((item) => (
                  <li>
                    <a href={`#${item.id}`} class="toc-link">
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )
      }
    </div>
  </div>

  <script>
    // Scroll-spy: keep the active heading marked in both TOC copies so a reader
    // always knows where they are in a long reference page.
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a.toc-link[href^="#"]'));
    const targets = links
      .map((link) => ({ link, section: document.getElementById(decodeURIComponent(link.hash.slice(1))) }))
      .filter((entry): entry is { link: HTMLAnchorElement; section: HTMLElement } => !!entry.section);

    if (targets.length) {
      let current: HTMLAnchorElement | null = null;
      const mark = () => {
        // The last heading whose top has passed the header is the active one.
        const offset = 120;
        let active = targets[0];
        for (const entry of targets) {
          if (entry.section.getBoundingClientRect().top - offset <= 0) active = entry;
        }
        if (active.link === current) return;
        current = active.link;
        links.forEach((link) => link.classList.toggle('is-active', link === active.link));
        document
          .querySelectorAll('a.toc-link.is-active')
          .forEach((link) => link.setAttribute('aria-current', 'true'));
      };
      window.addEventListener('scroll', mark, { passive: true });
      window.addEventListener('resize', mark, { passive: true });
      mark();
    }
  </script>
</BaseLayout>
