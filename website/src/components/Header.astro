---
import repoInfo from '../data/repo-info.json';
import { primaryNav } from '../data/site';
import { url } from '../utils/paths';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const currentPath = Astro.url.pathname;
const versionTag = `v${repoInfo.version}`;

const isActive = (href: string) => {
  const clean = href.replace(/\/$/, '') || '/';
  const here = currentPath.replace(/\/$/, '') || '/';
  if (clean === '/') return here === '/';
  return here === clean || here.startsWith(`${clean}/`);
};
---

<a
  href="#main"
  class="skip-link"
>
  Skip to content
</a>

<div id="scroll-progress" class="scroll-progress" aria-hidden="true"></div>

<header class="site-header sticky top-0 z-50 w-full glass border-b border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="site-header-inner flex items-center justify-between gap-2 h-14 lg:h-16">
      <div class="flex items-center gap-2 shrink-0 min-w-0">
        <a href={url('/')} class="group shrink-0 rounded-xl" aria-label="AutoTelegramForward home">
          <Logo />
        </a>
        <a
          href={url('/releases/')}
          class="hidden sm:inline-flex items-center gap-1.5 px-2 py-1 rounded-lg text-[11px] font-semibold bg-sky-950/80 text-sky-300 border border-sky-800/60 hover:border-sky-600 transition-colors"
          title={`Release ${versionTag} — release notes`}
        >
          <span class="pill-live-dot" aria-hidden="true"></span>
          {versionTag}
        </a>
      </div>

      <nav class="hidden xl:flex items-center gap-0.5" aria-label="Main navigation">
        {
          primaryNav.map((group) => (
            <details class="nav-pop">
              <summary
                class={`nav-pop-summary ${isActive(group.href) ? 'is-active' : ''}`}
                aria-label={`${group.name} menu`}
              >
                {group.name}
                <Icon name="chevron-right" class="w-3 h-3 rotate-90 opacity-60" strokeWidth={2.6} />
              </summary>
              <div class="nav-pop-panel">
                <a href={group.href} class="nav-pop-all">
                  <span>{group.name} overview</span>
                  <Icon name="arrow-right" class="w-3.5 h-3.5" />
                </a>
                <ul class="nav-pop-list">
                  {group.items?.map((item) => (
                    <li>
                      <a href={item.href} class="nav-pop-item" aria-current={isActive(item.href) ? 'page' : undefined}>
                        <span class="nav-pop-title">{item.name}</span>
                        {item.desc && <span class="nav-pop-desc">{item.desc}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          ))
        }
      </nav>

      <div class="flex items-center gap-1.5 sm:gap-2">
        <button
          type="button"
          id="search-open"
          class="flex items-center gap-2 px-2.5 sm:px-3 py-2 min-h-[40px] rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/60 border border-transparent hover:border-slate-700 transition-colors"
          aria-label="Search documentation (press Control or Command and K)"
          aria-keyshortcuts="Control+K Meta+K /"
        >
          <Icon name="search" class="w-4 h-4" />
          <span class="hidden md:inline text-slate-400">Search</span>
          <kbd class="hidden md:inline text-[10px] font-mono px-1.5 py-0.5 rounded border border-slate-700 bg-slate-900 text-slate-400">⌘K</kbd>
        </button>

        <button
          type="button"
          id="theme-toggle"
          class="theme-toggle"
          aria-label="Switch between light, dark and system theme"
          title="Theme: light / dark / system"
        >
          <Icon name="moon" class="theme-icon theme-icon-dark w-4 h-4" strokeWidth={2} />
          <Icon name="sun" class="theme-icon theme-icon-light w-4 h-4" strokeWidth={2} />
          <span class="hidden xl:inline" id="theme-label">Theme</span>
        </button>

        <a
          href={repoInfo.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:flex items-center gap-2 px-3 py-2 min-h-[40px] rounded-lg text-xs font-semibold bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 transition-colors"
          aria-label="AutoTelegramForward on GitHub"
        >
          <Icon name="github" class="w-4 h-4 text-slate-300" />
          <span class="hidden md:inline">GitHub</span>
        </a>

        <a
          href={url('/getting-started/')}
          class="hidden sm:flex items-center gap-1.5 px-3.5 py-2 min-h-[40px] rounded-lg text-xs font-semibold bg-tg-blue hover:bg-sky-500 text-white shadow-sm shadow-sky-500/25 transition-all"
        >
          <span>Install</span>
          <Icon name="arrow-right" class="w-3.5 h-3.5" strokeWidth={2.4} />
        </a>

        <button
          type="button"
          id="mobile-menu-btn"
          class="xl:hidden p-2.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 border border-slate-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Icon name="menu" class="w-5 h-5" id="menu-icon-open" />
          <Icon name="close" class="w-5 h-5 hidden" id="menu-icon-close" />
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden xl:hidden border-t border-slate-800 bg-slate-950/98 backdrop-blur-xl max-h-[calc(100dvh-3.5rem)] overflow-y-auto overscroll-contain"
  >
    <nav class="px-3 pt-3 pb-28 space-y-1.5" aria-label="Mobile navigation">
      {
        primaryNav.map((group) => (
          <details class="mobile-nav-group" open={isActive(group.href)}>
            <summary class="mobile-nav-summary">
              <span>{group.name}</span>
              <Icon name="chevron-right" class="w-4 h-4 text-slate-500 transition-transform group-open:rotate-90" />
            </summary>
            <div class="px-2 pb-2">
              <a href={group.href} class="block px-3 py-2.5 rounded-lg text-sm font-semibold text-sky-300 hover:bg-slate-800/70">
                {group.name} overview
              </a>
              {group.items?.map((item) => (
                <a
                  href={item.href}
                  class="block px-3 py-2.5 rounded-lg text-sm text-slate-300 hover:text-white hover:bg-slate-800/70"
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  <span class="block font-medium">{item.name}</span>
                  {item.desc && <span class="block text-[11.5px] text-slate-500 mt-0.5 leading-snug">{item.desc}</span>}
                </a>
              ))}
            </div>
          </details>
        ))
      }

      <div class="pt-3 mt-3 border-t border-slate-800 flex flex-col gap-2.5">
        <button type="button" id="theme-toggle-mobile" class="theme-toggle w-full justify-center py-3 text-sm">
          <Icon name="moon" class="theme-icon theme-icon-dark w-4 h-4" strokeWidth={2} />
          <Icon name="sun" class="theme-icon theme-icon-light w-4 h-4" strokeWidth={2} />
          <span id="theme-label-mobile">Appearance: dark</span>
        </button>
        <a
          href={url('/getting-started/')}
          class="w-full flex items-center justify-center gap-2 py-3 rounded-xl text-sm font-semibold bg-tg-blue hover:bg-sky-500 text-white shadow-md shadow-sky-500/20"
        >
          <Icon name="download" class="w-4 h-4" />
          Install AutoTelegramForward
        </a>
        <a
          href={repoInfo.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full flex items-center justify-center gap-2 py-3 rounded-xl text-sm font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700"
        >
          <Icon name="github" class="w-4 h-4" />
          View source on GitHub
        </a>
      </div>
    </nav>
  </div>
</header>

<div id="search-overlay" class="search-overlay hidden" role="dialog" aria-modal="true" aria-label="Search documentation">
  <button type="button" class="search-backdrop" data-search-close aria-label="Close search"></button>
  <div class="search-panel">
    <div class="flex items-center gap-3 px-4 py-3 border-b border-slate-800">
      <Icon name="search" class="w-4 h-4 text-slate-400 shrink-0" />
      <input
        id="search-input"
        type="search"
        autocomplete="off"
        placeholder="Search features, guides and reference…"
        class="flex-1 bg-transparent text-[15px] text-slate-100 placeholder-slate-500 focus:outline-none"
        aria-label="Search query"
        role="combobox"
        aria-expanded="true"
        aria-controls="search-results"
        aria-autocomplete="list"
        aria-activedescendant=""
      />
      <button
        type="button"
        class="text-[11px] font-mono px-2 py-1 rounded border border-slate-700 text-slate-400 hover:text-white"
        data-search-close
        aria-label="Close search"
      >
        ESC
      </button>
    </div>
    <ul id="search-results" class="search-results" role="listbox" aria-label="Search results"></ul>
    <div class="px-4 py-3 border-t border-slate-800 text-[11px] text-slate-500 search-hint">
      Search every feature, guide and reference page. Open with <kbd>⌘K</kbd> / <kbd>Ctrl K</kbd> or <kbd>/</kbd>,
      close with <kbd>Esc</kbd>, move with <kbd>↑</kbd> <kbd>↓</kbd> and open with <kbd>↵</kbd>.
    </div>
  </div>
</div>

<script>
  // ---------------------------------------------------------------- mobile menu
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  const setMenu = (open: boolean) => {
    if (!menu || !btn) return;
    btn.setAttribute('aria-expanded', String(open));
    menu.classList.toggle('hidden', !open);
    if (iconOpen) iconOpen.classList.toggle('hidden', open);
    if (iconClose) iconClose.classList.toggle('hidden', !open);
  };

  btn?.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));

  // Navigating from the drawer should not leave it open behind the new page.
  menu?.querySelectorAll('a[href]').forEach((link) =>
    link.addEventListener('click', () => setMenu(false)),
  );

  // ------------------------------------------------------------ scroll progress
  const bar = document.getElementById('scroll-progress');
  const siteHeader = document.querySelector<HTMLElement>('.site-header');
  let lastScrolled = false;
  const onScroll = () => {
    const doc = document.documentElement;
    const max = doc.scrollHeight - window.innerHeight;
    if (bar) bar.style.transform = `scaleX(${max > 0 ? Math.min(doc.scrollTop / max, 1) : 0})`;
    // One class flip, only when it changes: the header compacts after the fold.
    const scrolled = window.scrollY > 8;
    if (siteHeader && scrolled !== lastScrolled) {
      lastScrolled = scrolled;
      siteHeader.classList.toggle('is-scrolled', scrolled);
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // --------------------------------------------------- desktop dropdown hygiene
  const pops = Array.from(document.querySelectorAll('details.nav-pop')) as HTMLDetailsElement[];
  pops.forEach((pop) => {
    pop.addEventListener('toggle', () => {
      if (pop.open) pops.forEach((other) => { if (other !== pop) other.open = false; });
    });
  });
  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    pops.forEach((pop) => { if (pop.open && !pop.contains(target)) pop.open = false; });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') pops.forEach((pop) => { pop.open = false; });
  });

  // ------------------------------------------------------------------- search
  const base = import.meta.env.BASE_URL || '/';
  const overlay = document.getElementById('search-overlay');
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const results = document.getElementById('search-results');
  const openBtn = document.getElementById('search-open');

  type IndexEntry = { title: string; url: string; desc: string; section: string; keywords?: string };
  let index: IndexEntry[] = [];
  let loadFailed = false;
  let activeIndex = -1;

  async function loadIndex() {
    if (index.length > 0 || loadFailed) return;
    try {
      const res = await fetch(`${base}search.json`);
      index = (await res.json()) as IndexEntry[];
    } catch {
      loadFailed = true;
    }
  }

  const score = (entry: IndexEntry, q: string) => {
    const title = entry.title.toLowerCase();
    const desc = entry.desc.toLowerCase();
    const keys = (entry.keywords || '').toLowerCase();
    if (!`${title} ${desc} ${keys}`.includes(q)) return 0;
    let s = 1;
    if (title.startsWith(q)) s += 6;
    else if (title.includes(q)) s += 4;
    if (keys.includes(q)) s += 2;
    if (desc.includes(q)) s += 1;
    return s;
  };

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (char) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char] as string
    );

  function render(query: string) {
    if (!results) return;
    activeIndex = -1;
    const q = query.trim().toLowerCase();
    if (!q) {
      results.innerHTML = '<li class="search-empty">Type to search across the documentation.</li>';
      return;
    }
    const hits = index
      .map((entry) => ({ entry, s: score(entry, q) }))
      .filter((hit) => hit.s > 0)
      .sort((a, b) => b.s - a.s)
      .slice(0, 12);

    if (!hits.length) {
      results.innerHTML = `<li class="search-empty">No result for “${escapeHtml(query)}”. Try “routing”, “cleaner”, “upgrade” or “AI”.</li>`;
      return;
    }
    results.innerHTML = hits
      .map(
        ({ entry }, i) => `<li id="search-option-${i}" role="option" aria-selected="false">
        <a href="${escapeHtml(entry.url)}" class="search-result" data-index="${i}">
          <span class="search-result-head">
            <span class="search-result-title">${escapeHtml(entry.title)}</span>
            <span class="search-result-section">${escapeHtml(entry.section)}</span>
          </span>
          <span class="search-result-desc">${escapeHtml(entry.desc)}</span>
        </a>
      </li>`
      )
      .join('');
    if (q && hits.length > 0) activate(0);
  }

  /** Move the keyboard cursor over the rendered result list. */
  function activate(next: number) {
    if (!results) return;
    const options = Array.from(results.querySelectorAll<HTMLAnchorElement>('a.search-result'));
    if (!options.length) {
      activeIndex = -1;
      input?.setAttribute('aria-activedescendant', '');
      return;
    }
    activeIndex = (next + options.length) % options.length;
    options.forEach((option, i) => {
      const on = i === activeIndex;
      option.classList.toggle('is-active', on);
      option.parentElement?.setAttribute('aria-selected', String(on));
    });
    const active = options[activeIndex];
    input?.setAttribute('aria-activedescendant', `search-option-${activeIndex}`);
    active.scrollIntoView({ block: 'nearest' });
  }

  const isOpen = () => !!overlay && !overlay.classList.contains('hidden');

  async function openSearch() {
    if (!overlay) return;
    overlay.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    await loadIndex();
    input?.focus();
    input?.select();
    render(input?.value || '');
  }

  function closeSearch() {
    if (!overlay) return;
    overlay.classList.add('hidden');
    document.body.style.overflow = '';
  }

  openBtn?.addEventListener('click', openSearch);
  overlay?.querySelectorAll('[data-search-close]').forEach((el) => el.addEventListener('click', closeSearch));
  input?.addEventListener('input', () => render(input.value));

  document.addEventListener('keydown', (event) => {
    const tag = (event.target as HTMLElement)?.tagName || '';
    const typing = tag === 'INPUT' || tag === 'TEXTAREA' || (event.target as HTMLElement)?.isContentEditable;

    // Command palette: ⌘K / Ctrl+K from anywhere, / when not typing.
    if ((event.key === 'k' || event.key === 'K') && (event.metaKey || event.ctrlKey)) {
      event.preventDefault();
      if (isOpen()) closeSearch();
      else void openSearch();
      return;
    }
    if (event.key === '/' && !typing && !isOpen()) {
      event.preventDefault();
      void openSearch();
      return;
    }
    if (isOpen()) {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeSearch();
      } else if (event.key === 'ArrowDown') {
        event.preventDefault();
        activate(activeIndex + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        activate(activeIndex - 1);
      } else if (event.key === 'Enter') {
        const active = results?.querySelector<HTMLAnchorElement>('a.search-result.is-active');
        if (active) {
          event.preventDefault();
          window.location.href = active.href;
        }
      }
    }
  });

  // -------------------------------------------------------------------- theme
  // Three states: system → light → dark. `system` follows the OS live.
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: light)');
  const themeLabels: Record<string, string> = { system: 'Appearance: system', light: 'Appearance: light', dark: 'Appearance: dark' };

  const applyTheme = (mode: string, persist: boolean) => {
    const resolved = mode === 'system' ? (media.matches ? 'light' : 'dark') : mode;
    root.setAttribute('data-theme', resolved);
    root.setAttribute('data-theme-mode', mode);
    root.classList.toggle('dark', resolved === 'dark');
    document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
      meta.setAttribute('content', resolved === 'light' ? '#f6f8fc' : '#0b1120');
    });
    document.querySelectorAll('#theme-label, #theme-label-mobile').forEach((el) => {
      el.textContent = themeLabels[mode] ?? themeLabels.system;
    });
    if (persist) {
      try {
        if (mode === 'system') localStorage.removeItem('atf-theme');
        else localStorage.setItem('atf-theme', mode);
      } catch {
        /* private mode: the choice simply does not survive the session */
      }
    }
  };

  const cycleTheme = () => {
    const order = ['system', 'light', 'dark'];
    const current = root.getAttribute('data-theme-mode') || 'system';
    applyTheme(order[(order.indexOf(current) + 1) % order.length], true);
  };

  document.getElementById('theme-toggle')?.addEventListener('click', cycleTheme);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', cycleTheme);
  media.addEventListener('change', () => {
    if ((root.getAttribute('data-theme-mode') || 'system') === 'system') applyTheme('system', false);
  });
  applyTheme(root.getAttribute('data-theme-mode') || 'system', false);
</script>
