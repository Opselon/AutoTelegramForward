FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libc6-dev && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# The wheel cache lives in a mount, not in the image layer: repeat builds reuse
# the compiled wheels while the shipped image stays free of the cache.
RUN --mount=type=cache,id=atf-core-pip,target=/root/.cache/pip pip install -r requirements.txt

COPY proto/ ./proto/
COPY core/ ./core/
# The Telegram transport gateway the Go Worker consumes: telegram_runtime is
# served IN-PROCESS by core.main (see serve_telegram_runtime), so the package
# must ship in this image. Without it the gateway reports "unavailable" and
# the worker has no transport to send through.
COPY telegram_runtime/ ./telegram_runtime/
# The runtime serves worker/proto/telegram_gateway.proto and resolves the
# generated Python stubs by climbing to the repo root, so the worker proto
# tree must be in the image at the same relative path (/app/worker/proto).
COPY worker/proto/gen/ ./worker/proto/gen/
COPY worker/proto/telegram_gateway.proto ./worker/proto/telegram_gateway.proto
# The product version this build reports. The Go API image ships the same file
# at /etc/atf/VERSION and points ATF_VERSION_FILE at it; the core resolves it
# from the same locations, so the file has to be there for /api/stats to agree
# with /api/version and /api/system/setup. Without it every surface that
# forwards the core's answer reads "unknown".
COPY VERSION /etc/atf/VERSION

RUN mkdir -p /app/data

EXPOSE 50051

ENV ATF_DB_PATH=/app/data/atf.db \
    ATF_GRPC_HOST=0.0.0.0 \
    ATF_GRPC_PORT=50051 \
    ATF_LOGGER_ADDR=logger:50052 \
    ATF_VERSION_FILE=/etc/atf/VERSION

CMD ["python", "-m", "core.main"]
