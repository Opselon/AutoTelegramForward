---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils/paths';

const pageTitle = "404 — Page Not Found";
const pageDesc = "The page you are looking for does not exist or has been moved.";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <div class="min-h-[60vh] flex items-center justify-center py-20 px-4 text-center">
    <div class="max-w-md w-full glass-card p-8 rounded-2xl border border-slate-800 shadow-2xl space-y-6">
      <div class="w-16 h-16 rounded-2xl bg-sky-950 border border-sky-800 flex items-center justify-center mx-auto text-sky-400 font-mono text-2xl font-bold">
        404
      </div>
      <div>
        <h1 class="text-2xl font-extrabold text-white">Page Not Found</h1>
        <p class="text-xs text-slate-400 mt-2 leading-relaxed">
          The requested page could not be located. It may have moved or been reorganized in the latest documentation release.
        </p>
      </div>

      <div class="pt-4 border-t border-slate-800 space-y-2 text-xs">
        <a
          href={url('/')}
          class="block w-full py-2.5 rounded-xl font-semibold bg-sky-500 hover:bg-sky-400 text-white transition-colors"
        >
          Return to Homepage
        </a>
        <a
          href={url('/features/')}
          class="block w-full py-2.5 rounded-xl font-semibold bg-slate-900 hover:bg-slate-850 text-slate-300 border border-slate-800 transition-colors"
        >
          Explore Features
        </a>
        <a
          href={url('/getting-started/')}
          class="block w-full py-2.5 rounded-xl font-semibold bg-slate-900 hover:bg-slate-850 text-slate-300 border border-slate-800 transition-colors"
        >
          Installation Guide
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
