---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import SpecTable from '../../../components/SpecTable.astro';
import Callout from '../../../components/Callout.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import { url } from '../../../utils/paths';

const pageTitle = 'Secrets and keys';
const pageDesc =
  'What is encrypted, what is write-only, what is redacted before it reaches a log, and the exact rotation procedure for each credential the platform holds.';

const toc = [
  { id: 'inventory', title: 'The inventory' },
  { id: 'at-rest', title: 'Encryption at rest' },
  { id: 'write-only', title: 'Write-only by contract' },
  { id: 'redaction', title: 'Redaction in logs' },
  { id: 'rotation', title: 'Rotation' },
  { id: 'not-protected', title: 'What is not protected' },
];

const inventory = [
  ['Bot token', '<code>ATF_BOT_TOKEN</code>', 'Environment, per deployment', 'Sent only to Telegram. Never returned by any route.'],
  ['JWT signing secret', '<code>ATF_JWT_SECRET</code>', 'Environment', 'Signs the 7-day tokens. Rotating it invalidates every session at once.'],
  ['Database password', '<code>ATF_DB_PASSWORD</code>', 'Environment', 'Used inside the compose network; the database is not published by default.'],
  ['Redis password', '<code>ATF_REDIS_PASSWORD</code>', 'Environment', 'Protects the shared rate-limit and lease state.'],
  ['Encryption key', '<code>ATF_ENCRYPTION_KEY</code>', 'Environment, operator-supplied', 'AES-256-GCM for session strings, API keys and backup bundles.'],
  ['Tenant AI keys', 'per configuration', 'Database, encrypted', 'Write-only through the API; the response never carries the key back.'],
  ['Account passwords', 'per account', 'Database, hashed', 'PBKDF2-SHA256 with a per-row salt and stored iteration count.'],
  ['Telegram session strings', 'per session', 'Database, encrypted', 'A live session string is a credential; it is never returned in a list.'],
];

const redactionRows = [
  ['Phone numbers in log lines', '<code>+989121234567</code> → <code>+9891****4567</code>', 'Country prefix and last four digits survive, so two accounts stay distinguishable without being identifiable.'],
  ['Telegram usernames', '<code>@someone_long</code> → <code>so**********</code>', 'First two characters only — enough to match a report, not enough to identify a person.'],
  ['Anything that is not a phone number in a phone field', '<code>[REDACTED]</code>', 'Unstructured data in an identity field is not assumed benign.'],
  ['Provider credentials in a probe result', '<code>[REDACTED]</code>, truncated to 300 characters', 'Whatever the provider echoes back about a bad key is never repeated verbatim.'],
  ['Redis addresses and passwords', '<code>redis://[REDACTED]@host:port</code>', 'The status endpoint reports reachability without publishing the credential that made it reachable.'],
];
---

<DocsLayout
  title={pageTitle}
  description={pageDesc}
  path="/security/secrets/"
  breadcrumbs={[
    { name: 'Home', href: url('/') },
    { name: 'Security', href: url('/security/') },
    { name: 'Secrets and keys', href: url('/security/secrets/') },
  ]}
  toc={toc}
  keywords={[
    'AutoTelegramForward secrets handling',
    'AES-256-GCM session encryption',
    'API key write-only',
    'log redaction phone number',
  ]}
>
  <p>
    A forwarding platform necessarily holds the most sensitive credentials a user has: a Telegram session, a bot token, a
    model provider key. The design rule is narrow and applied consistently — a secret goes in, and it does not come back
    out. Not to a client, not to a log, not to an error message.
  </p>

  <section class="not-prose scroll-mt-24" id="inventory">
    <h2 class="display-3 text-white mb-3 scroll-mt-24">The inventory</h2>
    <SpecTable
      headers={['Secret', 'Where it lives', 'Notes', 'Who can read it back']}
      rows={inventory.map(([name, key, storage, note]) => [
        `<strong class="text-slate-100">${name}</strong><br /><code>${key}</code>`,
        storage,
        note,
        'nobody — no route returns it',
      ])}
      caption="Every credential the platform handles"
    />
    <Callout type="info" class="mt-4" title="The environment contract is a boolean map, not a values dump">
      <p>
        <code>GET /api/system/env</code> answers, for each recognised key, whether it is set and whether it is required,
        plus a hint that turns a missing key into an actionable next step. There is no route that returns a value, which
        is why the check is safe to leave reachable while an operator is debugging an install.
      </p>
    </Callout>
  </section>

  <section class="not-prose scroll-mt-24" id="at-rest">
    <h2 class="display-3 text-white mb-3 scroll-mt-24">Encryption at rest</h2>
    <div class="grid gap-4 lg:grid-cols-2">
      <div>
        <SpecTable
          headers={['Data', 'Primitive', 'Property']}
          rows={[
            ['Session strings, tenant API keys', '<strong>AES-256-GCM</strong>', 'Authenticated: a modified ciphertext fails to decrypt rather than decrypting into something else.'],
            ['Account passwords', '<strong>PBKDF2-SHA256</strong>, 240 000 iterations, per-row salt', 'Verified in constant time; the iteration count is stored per row so it can be raised without invalidating old hashes.'],
            ['Configuration backups', '<strong>AES-256-GCM bundle</strong>, key derived with PBKDF2-SHA256 at 600 000 iterations', 'Portable between hosts: export on one, import on the next. The bundle uses a higher iteration count than a password because its passphrase protects everything at once.'],
            ['Session backups', '<strong>Encrypted archive</strong>', 'Written only after the export succeeded; never in plaintext, not even transiently on disk.'],
          ]}
          caption="Cryptographic primitives and what each one guarantees"
        />
      </div>
      <div class="grid gap-3">
        <CodeBlock
          label="A correct environment check — no values"
          language="json"
          content={`{
  "checks": [
    { "key": "ATF_BOT_TOKEN", "set": true, "required": true },
    { "key": "ATF_ENCRYPTION_KEY", "set": true, "required": true },
    { "key": "ATF_REDIS_PASSWORD", "set": false, "required": false }
  ],
  "missing_required": [],
  "missing_recommended": ["ATF_REDIS_PASSWORD"],
  "ok": true
}`}
        />
        <Callout type="warning" title="The key is the data">
          <p>
            Encrypted material is only as safe as <code>ATF_ENCRYPTION_KEY</code>. Lose it and the backups are gone; leak
            it and the database is readable. It belongs in a secret manager or an operator-held file with restrictive
            permissions, not in a compose file committed to git.
          </p>
        </Callout>
      </div>
    </div>
  </section>

  <section class="not-prose scroll-mt-24" id="write-only">
    <h2 class="display-3 text-white mb-3 scroll-mt-24">Write-only by contract</h2>
    <p class="m-0 mb-4 text-[15px] leading-relaxed text-slate-300">
      Four surfaces accept a secret and none of them read one back. The asymmetry is deliberate: a client that needs to
      know whether a key works calls the probe, and a client that needs to change one sends a new value.
    </p>
    <SpecTable
      headers={['Surface', 'You send', 'You get back']}
      rows={[
        ['<code>POST /api/ai-configs</code>', 'The provider base URL, model and API key.', 'The configuration with the key masked or omitted.'],
        ['<code>POST /api/ai-configs/check-key</code>', 'A provider, endpoint and key to test.', 'Whether the model answered, in what latency, and a redacted detail — never the key.'],
        ['<code>POST /api/bot-tokens</code>', 'A bot token.', 'The registration and its bot identity. The token is validated with Telegram first, then stored.'],
        ['<code>POST /api/client/credentials</code>', 'Personal client credentials.', 'Acceptance. There is no read route.'],
        ['<code>POST /api/admin/settings</code>', 'Installation settings, including secrets.', 'The settings with secret fields masked.'],
      ]}
      caption="Every write-only secret surface"
    />
    <Callout type="success" class="mt-4" title="A probe that refuses to ask">
      <p>
        The credential probe distinguishes &quot;the provider said no&quot; from &quot;we refused to call it&quot;. A
        blocked endpoint is reported as <code>ran: false</code> with an error code, never as an unhealthy provider — so a
        tenant cannot use the probe to infer what exists on the host&apos;s private network.
      </p>
    </Callout>
  </section>

  <section class="not-prose scroll-mt-24" id="redaction">
    <h2 class="display-3 text-white mb-3 scroll-mt-24">Redaction in logs</h2>
    <p class="m-0 mb-4 text-[15px] leading-relaxed text-slate-300">
      Logs are where credentials leak by accident, so redaction is a single module used by every call site rather than a
      rule each author is trusted to remember:
    </p>
    <SpecTable headers={['Input', 'What is written', 'Why that shape']} rows={redactionRows} caption="What a log line may contain" />
    <div class="grid gap-3 lg:grid-cols-2 mt-4">
      <div class="panel panel--flush">
        <p class="micro m-0 mb-1">The access trail</p>
        <p class="m-0 text-[13.5px] leading-relaxed text-slate-300">
          Each request is recorded with the verified actor and the correlation id — the id comes from the validated token,
          so a spoofed header cannot attribute an action to somebody else.
        </p>
      </div>
      <div class="panel panel--flush">
        <p class="micro m-0 mb-1">Refusals are evidence</p>
        <p class="m-0 text-[13.5px] leading-relaxed text-slate-300">
          A refused key or a rejected token is logged as a security-relevant warning. The access logger sits outside the
          API-key gate precisely so a bad key is not invisible.
        </p>
      </div>
    </div>
  </section>

  <section class="not-prose scroll-mt-24" id="rotation">
    <h2 class="display-3 text-white mb-3 scroll-mt-24">Rotation</h2>
    <SpecTable
      headers={['Credential', 'How to rotate', 'Blast radius']}
      rows={[
        ['Bot token', 'Issue a new token with BotFather, update <code>ATF_BOT_TOKEN</code>, restart the bot service.', 'The bot goes offline until it restarts; queued deliveries resume.'],
        ['JWT secret', 'Set the new value and restart the API.', 'Every session ends at once — all users sign in again. Acceptable for a suspected compromise, disruptive otherwise.'],
        ['Encryption key', 'Re-encrypt before switching: export, import under the new key, then rotate the environment.', 'Doing this in the wrong order makes existing ciphertext unreadable. There is no recovery path.'],
        ['Tenant AI key', '<code>PUT /api/ai-configs/{id}</code> with the new key.', 'Only that tenant\'s AI calls.'],
        ['Account password', '<code>PATCH /api/auth/change-password</code> with the old password.', 'The account; a new login is required after expiry.'],
        ['Database password', 'Change it in the database and in <code>ATF_DB_PASSWORD</code>, then restart the API and core together.', 'Writes fail between the two restarts — do it in a maintenance window.'],
      ]}
      caption="Rotation, and what each one interrupts"
    />
  </section>

  <section class="not-prose scroll-mt-24" id="not-protected">
    <h2 class="display-3 text-white mb-3 scroll-mt-24">What is not protected</h2>
    <ul class="grid gap-2 list-none p-0 m-0">
      <li class="flex gap-2 text-[14.5px] text-slate-300">
        <span class="text-amber-400 shrink-0">!</span>
        <span><strong class="text-slate-100">Transport inside the compose network.</strong> Containers speak plain gRPC and HTTP to each other. TLS is expected at the reverse proxy, and the network boundary is the container network.</span>
      </li>
      <li class="flex gap-2 text-[14.5px] text-slate-300">
        <span class="text-amber-400 shrink-0">!</span>
        <span><strong class="text-slate-100">A stolen bot token is a stolen bot.</strong> Validation on registration proves the token works; it cannot prove who holds it later. Revoke with BotFather, then remove the registration.</span>
      </li>
      <li class="flex gap-2 text-[14.5px] text-slate-300">
        <span class="text-amber-400 shrink-0">!</span>
        <span><strong class="text-slate-100">A Telegram session file is a logged-in client.</strong> That is why it is encrypted at rest and never returned by a list route — but on a running host, the decrypted material exists in memory for as long as the session does.</span>
      </li>
      <li class="flex gap-2 text-[14.5px] text-slate-300">
        <span class="text-amber-400 shrink-0">!</span>
        <span><strong class="text-slate-100">The operator&apos;s own host.</strong> Root on the machine that runs the stack can read the environment and the database. No application-level control changes that.</span>
      </li>
    </ul>
  </section>
</DocsLayout>
