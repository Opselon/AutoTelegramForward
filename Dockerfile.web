# Multi-stage Dockerfile for AutoTelegramForward Web Microservice
# Frontend: React + TypeScript
# Backend: Rust + Axum

# Stage 1: Build Frontend
FROM node:20-alpine AS frontend-builder
WORKDIR /app/frontend
COPY web/frontend/package*.json ./
RUN npm ci || npm install
COPY web/frontend/ ./
RUN npm run build

# Stage 2: Build Rust Backend
FROM rust:1.80-slim-bullseye AS backend-builder
WORKDIR /app/backend
RUN apt-get update && apt-get install -y pkg-config libssl-dev build-essential && rm -rf /var/lib/apt/lists/*
COPY web/backend/Cargo.toml web/backend/Cargo.lock* ./
RUN mkdir src && echo "fn main() {}" > src/main.rs && cargo build --release || true
COPY web/backend/src ./src
RUN touch src/main.rs && cargo build --release

# Stage 3: Runtime
FROM debian:bullseye-slim
WORKDIR /app
RUN apt-get update && apt-get install -y ca-certificates sqlite3 && rm -rf /var/lib/apt/lists/*
COPY --from=backend-builder /app/backend/target/release/atf-web-backend /app/atf-web-backend
COPY --from=frontend-builder /app/frontend/dist /app/web/frontend/dist

ENV ATF_WEB_ADDR=0.0.0.0:8088
ENV ATF_DB_PATH=/app/data/atf.db
ENV ATF_LOGS_DB_PATH=/app/data/atf_logs.db

EXPOSE 8088
ENTRYPOINT ["/app/atf-web-backend"]
