---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { url } from '../utils/paths';

const pageTitle = '404 — page not found';
const pageDesc = 'That page does not exist. Jump back into the documentation, the feature deep dives or the install guide.';

const destinations = [
  { name: 'Feature overview', href: url('/features/'), icon: 'sparkles', desc: 'Every capability, grouped by subsystem' },
  { name: 'Install guide', href: url('/getting-started/'), icon: 'download', desc: 'Docker, source or portable — pick one' },
  { name: 'REST API', href: url('/api/'), icon: 'chip', desc: 'Every route the control plane serves' },
  { name: 'CLI reference', href: url('/cli/'), icon: 'terminal', desc: 'The atf command groups' },
  { name: 'Playground', href: url('/tools/playground/'), icon: 'beaker', desc: 'Try the cleaner in your browser' },
  { name: 'FAQ', href: url('/faq/'), icon: 'book', desc: 'Straight answers, no marketing' },
];
---

<BaseLayout title={pageTitle} description={pageDesc} noindex>
  <section class="container-x py-16 sm:py-24 text-center">
    <p class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-slate-900 border border-slate-800 text-slate-400 mb-6">
      <Icon name="alert" class="w-3.5 h-3.5 text-amber-400" />
      Error 404
    </p>

    <h1 class="display-1 text-white mb-4">We cannot find that page</h1>
    <p class="lede mx-auto max-w-xl mb-8">
      The link may be from an older release, or the page moved while the documentation was reorganised. Everything below
      is one click away.
    </p>

    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 mb-12 max-w-lg mx-auto">
      <a href={url('/')} class="btn btn-primary w-full sm:w-auto px-7">
        <Icon name="home" class="w-4 h-4" />
        Back to home
      </a>
      <button type="button" data-search-open class="btn btn-secondary w-full sm:w-auto px-7">
        <Icon name="search" class="w-4 h-4" />
        Search the docs
      </button>
    </div>

    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 max-w-4xl mx-auto list-none p-0 text-left">
      {
        destinations.map((item) => (
          <li>
            <a href={item.href} class="card block h-full hover:border-sky-700 transition-colors">
              <span class="inline-flex items-center gap-2 text-slate-100 font-semibold text-sm mb-1">
                <Icon name={item.icon} class="w-4 h-4 text-sky-400" />
                {item.name}
              </span>
              <span class="block text-[13px] text-slate-400">{item.desc}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
