FROM golang:1.27-alpine AS builder

WORKDIR /build
COPY api/go.mod api/go.sum ./
RUN go mod download

COPY api/ .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /atf-api .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=builder /atf-api /usr/local/bin/atf-api

EXPOSE 8080
ENV ATF_CORE_GRPC=core:50051 \
    ATF_API_ADDR=:8080

CMD ["atf-api"]
