    {
      "code": "[[ORIGIN_POST_DATE]]",
      "desc": "Original publication timestamp (UTC)",
      "example": "2026-10-16 14:00 UTC"
    },
    {
      "code": "[[ORIGIN_NAME_URL]]",
      "desc": "Markdown hyperlink back to the original post",
      "example": "[Crypto News](https://t.me/cryptonewsdaily/4921)"
