---
import repoInfo from '../data/repo-info.json';
import { seoKeywords } from '../data/site';

interface FaqEntry {
  q: string;
  a: string;
}

interface HowToStep {
  name: string;
  text: string;
}

interface ListEntry {
  name: string;
  description: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  breadcrumbs?: Array<{ name: string; url: string }>;
  articleDate?: string;
  articleModified?: string;
  keywords?: string[];
  faq?: FaqEntry[];
  howTo?: { name: string; description: string; steps: HowToStep[] };
  itemList?: { name: string; items: ListEntry[] };
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  type = 'website',
  image = '/assets/og-image.png',
  imageAlt = 'AutoTelegramForward — self-hosted Telegram message routing platform',
  breadcrumbs,
  articleDate,
  articleModified,
  keywords = seoKeywords,
  faq,
  howTo,
  itemList,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://opselon.github.io';
// The site ships under a base path (GitHub Pages project site), so any URL that
// is not already base-prefixed has to be joined with siteUrl + BASE_URL.
const basePath = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const baseUrl = `${siteUrl}${basePath}`;
const absolute = (value: string) => {
  if (value.startsWith('http')) return value;
  const path = value.startsWith('/') ? value : `/${value}`;
  // Already base-prefixed paths (produced by utils/paths url()) must not be
  // prefixed twice.
  return path.startsWith(`${basePath}/`) || path === basePath ? `${siteUrl}${path}` : `${baseUrl}${path}`;
};
const currentPath = Astro.url.pathname;
const canonicalUrl = canonical ? absolute(canonical) : `${siteUrl}${currentPath}`;
const fullImageUrl = absolute(image);
const fullTitle = title.includes('AutoTelegramForward') ? title : `${title} | AutoTelegramForward`;
const repoUrl = repoInfo.repoUrl;

const breadcrumbSchema =
  breadcrumbs && breadcrumbs.length > 0
    ? {
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((b, idx) => ({
          '@type': 'ListItem',
          position: idx + 1,
          name: b.name,
          item: absolute(b.url),
        })),
      }
    : null;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${baseUrl}/#website`,
    url: `${baseUrl}/`,
    name: 'AutoTelegramForward',
    description:
      'Documentation, reference and live playground for AutoTelegramForward, a self-hosted Telegram message routing platform.',
    inLanguage: 'en',
    publisher: { '@id': `${repoUrl}#organization` },
  },
  {
    '@type': 'SoftwareApplication',
    '@id': `${baseUrl}/#software`,
    name: 'AutoTelegramForward',
    description: repoInfo.verifiedFeatures
      .flatMap((g: { items: string[] }) => g.items)
      .slice(0, 12)
      .join('; '),
    applicationCategory: 'CommunicationApplication',
    applicationSubCategory: 'Telegram message routing and forwarding',
    operatingSystem: 'Linux, Windows, macOS, Docker, Kubernetes',
    softwareVersion: repoInfo.version,
    softwareHelp: `${baseUrl}/`,
    releaseNotes: absolute('/releases/'),
    downloadUrl: `${repoUrl}/releases/latest`,
    installUrl: absolute('/getting-started/'),
    codeRepository: repoUrl,
    programmingLanguage: ['Python', 'Go', 'Rust', 'TypeScript', 'Dart'],
    license: 'https://opensource.org/licenses/MIT',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0.00', priceCurrency: 'USD' },
    author: { '@id': `${repoUrl}#organization` },
    keywords: keywords.join(', '),
  },
  {
    '@type': 'Organization',
    '@id': `${repoUrl}#organization`,
    name: 'Opselon',
    url: 'https://github.com/Opselon',
    sameAs: [repoUrl],
  },
];

if (breadcrumbSchema) graph.push(breadcrumbSchema);

if (faq && faq.length > 0) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: faq.map((entry) => ({
      '@type': 'Question',
      name: entry.q,
      acceptedAnswer: { '@type': 'Answer', text: entry.a },
    })),
  });
}

if (howTo) {
  graph.push({
    '@type': 'HowTo',
    name: howTo.name,
    description: howTo.description,
    totalTime: 'PT10M',
    step: howTo.steps.map((s, idx) => ({
      '@type': 'HowToStep',
      position: idx + 1,
      name: s.name,
      text: s.text,
    })),
  });
}

if (itemList) {
  graph.push({
    '@type': 'ItemList',
    name: itemList.name,
    numberOfItems: itemList.items.length,
    itemListElement: itemList.items.map((item, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: item.name,
      description: item.description,
      url: absolute(item.url),
    })),
  });
}

const schema = { '@context': 'https://schema.org', '@graph': graph };
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords.join(', ')} />
<meta name="author" content="Opselon" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#0b1120" />
<meta name="generator" content="Astro" />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
<meta name="application-name" content="AutoTelegramForward" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="AutoTelegramForward" />
<meta name="format-detection" content="telephone=no" />
<meta name="msapplication-TileColor" content="#0b1120" />
<link rel="canonical" href={canonicalUrl} />
<link rel="manifest" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/site.webmanifest`} />
<link rel="alternate" hreflang="en" href={canonicalUrl} />
<link rel="alternate" hreflang="x-default" href={canonicalUrl} />
<link rel="sitemap" type="application/xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/sitemap-index.xml`} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="AutoTelegramForward" />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:width" content="1280" />
<meta property="og:image:height" content="640" />
<meta property="og:image:alt" content={imageAlt} />
{articleDate && <meta property="article:published_time" content={articleDate} />}
{articleModified && <meta property="article:modified_time" content={articleModified} />}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@Capxi" />
<meta name="twitter:creator" content="@Capxi" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Structured data: one connected graph per page -->
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
