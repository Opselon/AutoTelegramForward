    {
      "code": "[[SOURCE_NAME]]",
      "desc": "Alias for the source channel name",
      "example": "Crypto News Daily"
    },
    {
      "code": "[[SENDER_CHAT]]",
      "desc": "Chat id or title the post was sent in",
      "example": "-1001695513745"
    },
    {
      "code": "[[FORWARD_FROM_CHAT]]",
      "desc": "Original channel when the incoming post was itself a forward",
      "example": "Reuters Telegram"
    },
    {
      "code": "[[FROM_USER]]",
      "desc": "Display name of the original author",
      "example": "John Doe"
    }
