I","kind":"client","tier":6,"tech":"Python + atf entrypoint","role":"Install, validate, diagnose, upgrade","color":"#22d3ee","files":37,"loc":6759,"langs":["python"],"evidence":["atfcli/cli.py","atfcli/commands/__init__.py","atfcli/commands/_shared.py","atf.py"],"external":false},{"id":"edge-proxy","label":"TLS edge","kind":"edge","tier":7,"tech":"Caddy (optional profile)","role":"Automatic Let's Encrypt certificate and reverse proxy","color":"#e879f9","files":0,"loc":0,"langs":[],"evidence":["web/backend/src/main.rs","Caddyfile"],"external":false}],"componentEdges":[{"source":"telegram-cloud","target":"core-ingest","kind":"mtproto","label":"Updates in","protocol":"MTProto","metric":"live"},{"source":"core-ingest","target":"core-pipeline","kind":"event","label":"Normalised update","protocol":"in-process","metric":"per message"},{"source":"core-pipeline","target":"core-queue","kind":"event","label":"Enqueue after policy","protocol":"in-process","metric":"per target"},{"source":"core-queue","target":"telegram-cloud","kind":"mtproto","label":"Delivery","protocol":"MTProto send","metric":"per target"},{"source":"core-pipeline","target":"ai-rewriter","kind":"http","label":"Rewrite pass","protocol":"HTTP JSON","metric":"optional"},{"source":"core-pipeline","target":"core-storage","kind":"sql","label":"Rules & state","protocol":"SQL","metric":"per decision"},{"source":"core-queue","target":"core-storage","kind":"sql","label":"Queue & leases","protocol":"SQL","metric":"per job"},{"source":"core-grpc","target":"core-pipeline","kind":"event","label":"Commands in","protocol":"in-process","metric":"61 RPCs"},{"source":"core-grpc","target":"core-storage","kind":"sql","label":"Reads & writes","protocol":"SQL","metric":"per call"},{"source":"core-ingest","target":"logger-svc","kind":"grpc","label":"Stage events","protocol":"gRPC","metric":"per stage"},{"source":"core-pipeline","target":"logger-svc","kind":"grpc","label":"Stage events","protocol":"gRPC","metric":"per stage"},{"source":"core-queue","target":"logger-svc","kind":"grpc","label":"Delivery outcomes","protocol":"gRPC","metric":"per delivery"},{"source":"logger-svc","target":"logger-store","kind":"sql","label":"Append","protocol":"SQL","metric":"per event"},{"source":"api-rest","target":"core-grpc","kind":"grpc","label":"Control calls","protocol":"gRPC","metric":"61 RPCs"},{"source":"api-rest","target":"logger-svc","kind":"grpc","label":"API logs & audit","protocol":"gRPC","metric":"per request"},{"source":"api-rest","target":"api-guardrails","kind":"event","label":"Middleware chain","protocol":"in-process","metric":"per request"},{"source":"web-backend","target":"api-rest","kind":"http","label":"Proxy + SSE","protocol":"HTTP/1.1","metric":"per request"},{"source":"web-backend","target":"web-ui","kind":"http","label":"Static bundle","protocol":"HTTP","metric":"per visit"},{"source":"web-ui","target":"web-backend","kind":"http","label":"Dashboard calls","protocol":"/api/v1","metric":"per action"},{"source":"mobile-app","target":"api-rest","kind":"http","label":"Mobile calls","protocol":"HTTPS","metric":"per action"},{"source":"cli","target":"api-rest","kind":"http","label":"Diagnostics","protocol":"HTTP","metric":"per run"},{"source":"cli","target":"web-backend","kind":"http","label":"Gateway health","protocol":"HTTP","metric":"per run"},{"source":"edge-proxy","target":"web-backend","kind":"proxy","label":"Terminate TLS","protocol":"reverse proxy","metric":"per request"}],"flows":[{"id":"forward","title":"A post is forwarded","summary":"From an incoming Telegram update to a delivered copy in every target chat, with the durable queue absorbing rate limits.","steps":[{"at":"telegram-cloud","action":"Update arrives","detail":"MTProto push from the source chat the session is authorised for.","tags":["INGEST","DIALOG_FETCH"]},{"at":"core-ingest","action":"Normalise","detail":"Album items are aggregated and the update is turned into a domain event.","tags":[]},{"at":"core-pipeline","action":"Resolve policy","detail":"Matching tasks, per-source/policy overrides, whitelists and blacklists.","tags":["POLICY","POLICY_TARGET","NO_RULES","NO_MATCH"]},{"at":"core-pipeline","action":"Filter & rewrite","detail":"Filters, cleaner, shortcodes, replacements — and the optional AI pass.","tags":["FILTER","CLEANER","TRANSFORM","AI_REWRITE"]},{"at":"ai-rewriter","action":"Rewrite (optional)","detail":"Only when the task enables it; an unreachable provider passes the text through.","tags":["AI_REWRITE"]},{"at":"core-queue","action":"Enqueue per target","detail":"One durable job per target with an ordering key, so bursts keep their order.","tags":["ENQUEUE"]},{"at":"core-queue","action":"Lease & deliver","detail":"Lease-based workers with exponential backoff and FloodWait-aware rescheduling.","tags":["RETRY","FLOODWAIT"]},{"at":"telegram-cloud","action":"Delivered","detail":"Copy mode or native forward, into the target chat or forum topic.","tags":["DELIVERED"]},{"at":"logger-svc","action":"Recorded","detail":"Every stage, drop and outcome lands in the log store with a correlation id.","tags":["DROP","FILTER_DROP","DUP_FILTER","DELIVERY_FAIL","DELIVERY_TIMEOUT"]}]},{"id":"control","title":"An operator edits a task","summary":"A dashboard write travels through the gateway, the REST control plane and gRPC into the engine — with optimistic concurrency and an audit trail.","steps":[{"at":"web-ui","action":"Operator saves","detail":"A tenant-scoped token is attached to the request; no API key ever reaches the browser.","tags":[]},{"at":"web-backend","action":"Gateway proxies","detail":"The Rust gateway forwards to the API and keeps upstream addressing server-side.","tags":[]},{"at":"api-guardrails","action":"Guardrails","detail":"Correlation id, access log, log-policy gate and audit event are applied first.","tags":[]},{"at":"api-rest","action":"Authorise","detail":"Fail-closed tenant check: the rule is only touched if it belongs to the caller.","tags":[]},{"at":"core-grpc"