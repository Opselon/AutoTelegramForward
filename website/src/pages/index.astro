---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuickstartCard from '../components/QuickstartCard.astro';
import ArchitectureDiagram from '../components/ArchitectureDiagram.astro';
import Playground from '../components/Playground.astro';
import repoInfo from '../data/repo-info.json';
import { url } from '../utils/paths';

const pageTitle = "AutoTelegramForward — Production Telegram Message Forwarding Engine";
const pageDesc = "High-performance, multi-tenant Telegram forwarding bot with intelligent content cleaning, granular filters, dynamic header/footer shortcodes, copy-protection bypass, and durable queue resilience.";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28">
    <!-- Background Glow -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-gradient-to-tr from-sky-500/15 via-emerald-500/10 to-transparent blur-3xl pointer-events-none -z-10 rounded-full"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      
      <!-- Top Release Pill -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-slate-900 border border-slate-800 text-slate-300 shadow-md mb-8 hover:border-slate-700 transition-colors">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Version {repoInfo.version} Available</span>
        <span class="text-slate-600">•</span>
        <a href={url('/releases/')} class="text-sky-400 hover:text-sky-300">What's New →</a>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white max-w-4xl mx-auto leading-[1.1] mb-6">
        Intelligent, Resilient <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-sky-400 via-emerald-400 to-sky-300 bg-clip-text text-transparent">
          Telegram Message Forwarding
        </span>
      </h1>

      <!-- Subheadline -->
      <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed mb-10">
        Automate real-time channel & group broadcasting with granular content cleaning (URLs, @mentions, #hashtags), 12 dynamic shortcodes, ReDoS-safe filters, and automatic FloodWait pausing.
      </p>

      <!-- Primary Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
        <a
          href={url('/getting-started/')}
          class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-semibold text-sm bg-gradient-to-r from-tg-blue to-sky-500 hover:from-sky-500 hover:to-sky-400 text-white shadow-lg shadow-sky-500/25 transition-all flex items-center justify-center gap-2 group"
        >
          <span>Get Started Free</span>
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </a>

        <a
          href={url('/tools/playground/')}
          class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-semibold text-sm bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700/80 transition-colors flex items-center justify-center gap-2"
        >
          <span>Interactive Playground</span>
        </a>

        <a
          href={repoInfo.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-semibold text-sm bg-slate-950 hover:bg-slate-900 text-slate-400 hover:text-slate-200 border border-slate-800 transition-colors flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4 text-slate-300" viewBox="0 0 24 24" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>Star on GitHub</span>
        </a>
      </div>

      <!-- Quickstart Snippet Card -->
      <div class="max-w-3xl mx-auto text-left">
        <QuickstartCard />
      </div>

    </div>
  </section>

  <!-- Key Metrics / Assurance Strip -->
  <section class="border-y border-slate-900 bg-slate-950/60 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <div class="text-3xl font-extrabold text-white font-mono">100%</div>
          <div class="text-xs text-slate-400 mt-1 uppercase tracking-wider font-semibold">Fail-Closed Isolation</div>
        </div>
        <div>
          <div class="text-3xl font-extrabold text-sky-400 font-mono">12+</div>
          <div class="text-xs text-slate-400 mt-1 uppercase tracking-wider font-semibold">Validated Shortcodes</div>
        </div>
        <div>
          <div class="text-3xl font-extrabold text-emerald-400 font-mono">0.8s</div>
          <div class="text-xs text-slate-400 mt-1 uppercase tracking-wider font-semibold">Album Debounce Window</div>
        </div>
        <div>
          <div class="text-3xl font-extrabold text-amber-400 font-mono">375+</div>
          <div class="text-xs text-slate-400 mt-1 uppercase tracking-wider font-semibold">Passing Unit & E2E Tests</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Features Grid -->
  <section class="py-16 lg:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs font-bold text-sky-400 uppercase tracking-widest mb-3">Enterprise-Grade Features</h2>
      <h3 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Engineered for Reliability, Speed & Control
      </h3>
      <p class="text-slate-400 mt-3 text-base">
        Every capability is backed by real domain services, durable SQLite/PostgreSQL persistence, and asynchronous worker queues.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Card 1: Content Cleaner -->
      <div class="glass-card p-6 rounded-2xl">
        <div class="w-10 h-10 rounded-xl bg-sky-950 text-sky-400 border border-sky-800 flex items-center justify-center mb-4">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </div>
        <h4 class="text-lg font-bold text-white mb-2">Advanced Content Cleaner</h4>
        <p class="text-sm text-slate-400 leading-relaxed mb-4">
          Strip URLs, Telegram t.me links, @mentions, multi-lingual #hashtags, phone numbers, emojis, and custom keyword lists with zero regex crashes.
        </p>
        <a href={url('/features/text-cleaner/')} class="text-xs font-semibold text-sky-400 hover:text-sky-300 flex items-center gap-1">
          Explore Cleaner Details →
        </a>
      </div>

      <!-- Card 2: Header / Footer Shortcodes -->
      <div class="glass-card p-6 rounded-2xl">
        <div class="w-10 h-10 rounded-xl bg-emerald-950 text-emerald-400 border border-emerald-800 flex items-center justify-center mb-4">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
          </svg>
        </div>
        <h4 class="text-lg font-bold text-white mb-2">Dynamic Shortcodes</h4>
        <p class="text-sm text-slate-400 leading-relaxed mb-4">
          Personalize forwarded messages using 12 validated shortcodes like <code>[[ORIGIN_NAME]]</code>, <code>[[ORIGIN_POST_ID]]</code>, and dynamic clickable channel links.
        </p>
        <a href={url('/features/headers-footers-shortcodes/')} class="text-xs font-semibold text-emerald-400 hover:text-emerald-300 flex items-center gap-1">
          View Shortcodes Reference →
        </a>
      </div>

      <!-- Card 3: Whitelist & Filters -->
      <div class="glass-card p-6 rounded-2xl">
        <div class="w-10 h-10 rounded-xl bg-purple-950 text-purple-400 border border-purple-800 flex items-center justify-center mb-4">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
          </svg>
        </div>
        <h4 class="text-lg font-bold text-white mb-2">Deterministic Filtering</h4>
        <p class="text-sm text-slate-400 leading-relaxed mb-4">
          Block forbidden keywords, require whitelist terms, filter media types (video, audio, stickers, voice, text), and drop spam links automatically.
        </p>
        <a href={url('/features/whitelist-blacklist-filters/')} class="text-xs font-semibold text-purple-400 hover:text-purple-300 flex items-center gap-1">
          Filter Rules & Logic →
        </a>
      </div>

      <!-- Card 4: Copy-Protection Bypass -->
      <div class="glass-card p-6 rounded-2xl">
        <div class="w-10 h-10 rounded-xl bg-amber-950 text-amber-400 border border-amber-800 flex items-center justify-center mb-4">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <h4 class="text-lg font-bold text-white mb-2">Restricted Content Bypass</h4>
        <p class="text-sm text-slate-400 leading-relaxed mb-4">
          When channels block standard forwarding with <code>ChatForwardsRestricted</code>, ATF automatically downloads and re-uploads media cleanly.
        </p>
        <a href={url('/features/media-and-albums/')} class="text-xs font-semibold text-amber-400 hover:text-amber-300 flex items-center gap-1">
          Media Handling Guide →
        </a>
      </div>

      <!-- Card 5: FloodWait Auto-Resume -->
      <div class="glass-card p-6 rounded-2xl">
        <div class="w-10 h-10 rounded-xl bg-rose-950 text-rose-400 border border-rose-800 flex items-center justify-center mb-4">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h4 class="text-lg font-bold text-white mb-2">FloodWait Auto-Resumption</h4>
        <p class="text-sm text-slate-400 leading-relaxed mb-4">
          Accounts hitting Telegram rate-limits automatically pause their queues and safely resume forwarding the second the time-limit expires.
        </p>
        <a href={url('/operations/')} class="text-xs font-semibold text-rose-400 hover:text-rose-300 flex items-center gap-1">
          Operational Diagnostics →
        </a>
      </div>

      <!-- Card 6: Multi-Tenant Isolation -->
      <div class="glass-card p-6 rounded-2xl">
        <div class="w-10 h-10 rounded-xl bg-emerald-950 text-emerald-400 border border-emerald-800 flex items-center justify-center mb-4">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <h4 class="text-lg font-bold text-white mb-2">Fail-Closed Multi-Tenancy</h4>
        <p class="text-sm text-slate-400 leading-relaxed mb-4">
          Strict server-side validation guarantees users only manage their own tasks, sessions, and configs. Zero cross-tenant data leaks.
        </p>
        <a href={url('/features/multi-tenant-security/')} class="text-xs font-semibold text-emerald-400 hover:text-emerald-300 flex items-center gap-1">
          Security Principles →
        </a>
      </div>

    </div>
  </section>

  <!-- Architecture Overview Section -->
  <section class="py-12 lg:py-16 bg-slate-900/30 border-y border-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ArchitectureDiagram />
    </div>
  </section>

  <!-- Interactive Sandbox Section -->
  <section class="py-16 lg:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-10 text-center max-w-2xl mx-auto">
      <h2 class="text-xs font-bold text-emerald-400 uppercase tracking-widest mb-2">Try It In Browser</h2>
      <h3 class="text-3xl font-extrabold text-white">Live Transformation Simulator</h3>
      <p class="text-slate-400 text-sm mt-2">
        See how AutoTelegramForward strips ads and formats messages before you even install it.
      </p>
    </div>
    <Playground />
  </section>

  <!-- Supported Message Types Matrix -->
  <section class="py-12 lg:py-16 border-t border-slate-900 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h3 class="text-2xl font-bold text-white">Supported Telegram Content Types</h3>
        <p class="text-slate-400 text-sm mt-1">
          Comprehensive support for all Telegram message classes verified against live API calls.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 text-xs font-mono">
        {repoInfo.supportedMediaTypes.map((item) => (
          <div class="p-3.5 rounded-xl bg-slate-900/60 border border-slate-800/80 flex flex-col justify-between">
            <div class="font-bold text-white mb-1 font-sans">{item.type}</div>
            <div class="text-[11px] text-slate-400 mb-2 font-sans">{item.desc}</div>
            <span class="inline-flex self-start px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-950 text-emerald-400 border border-emerald-800/60">
              {item.status}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA Callout -->
  <section class="py-16 lg:py-20 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="p-8 sm:p-12 rounded-3xl bg-gradient-to-b from-slate-900 to-slate-950 border border-slate-800 shadow-2xl relative overflow-hidden">
      <div class="absolute -right-16 -top-16 w-64 h-64 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <h3 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        Ready to Automate Your Telegram Channels?
      </h3>
      <p class="text-slate-300 text-base max-w-xl mx-auto mb-8 leading-relaxed">
        Deploy in minutes using Docker Compose, native Linux systemd, or Windows PowerShell. Open-source under the MIT license.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={url('/getting-started/')}
          class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-semibold text-sm bg-tg-blue hover:bg-sky-500 text-white shadow-lg shadow-sky-500/25 transition-all"
        >
          Read Installation Guide
        </a>
        <a
          href={url('/features/')}
          class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-semibold text-sm bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-colors"
        >
          Browse All Features
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
