# Copy to .env and fill in — used by docker-compose
ATF_API_ID=17349
ATF_API_HASH=344583e45741c457fe1862106095a5eb
ATF_BOT_TOKEN=123456:ABC-your-bot-token
ADMIN_USER_ID=5094837833
ADMIN_IDS=5094837833
ATF_MASTER_KEY=generate-a-long-random-string-here
ATF_API_KEY=optional-rest-api-key

# Public URL the dashboard/gateway advertises for this deployment (used by the
# web container and by health checks that need the external address).
ATF_WEB_URL=http://localhost:8088

# --- Diagnostic raw MTProto tracing (off unless you are debugging the wire)
# When set to 1, the Core logs a bounded, single-line summary of every Telegram
# request/response to the container log. Credentials (access_hash,
# file_reference, tokens) are masked, but the volume is high: a busy account can
# produce tens of thousands of lines an hour. Leave it unset in production.
# ATF_RAW_API_TRACE=1

# --- Optional TLS reverse proxy (enable with: docker compose --profile tls up -d)
# ATF_TLS_DOMAIN points Caddy at your domain; it provisions a Let's Encrypt
# certificate automatically. ATF_TLS_EMAIL is used for ACME account registration.
ATF_TLS_DOMAIN=panel.example.com
ATF_TLS_EMAIL=admin@example.com

# --- Authoritative PostgreSQL Database (Production Hardening)
# ATF_DATABASE_URL=postgresql://atf:atf_secure_password@postgres:5432/atf_db
# ATF_POSTGRES_ALL=1
