---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { url } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  breadcrumbs: Array<{ name: string; href?: string }>;
  activeSlug?: string;
  toc?: Array<{ id: string; title: string }>;
  prev?: { title: string; href: string };
  next?: { title: string; href: string };
}

const {
  title,
  description,
  breadcrumbs,
  activeSlug = '',
  toc = [],
  prev,
  next,
} = Astro.props;

const docNav = [
  {
    category: 'Getting Started',
    items: [
      { title: 'Overview & Prerequisites', href: url('/getting-started/') },
      { title: 'Docker Compose Deployment', href: url('/getting-started/docker/') },
      { title: 'Linux & Windows Setup', href: url('/getting-started/linux-windows/') },
      { title: 'Telegram Bot Configuration', href: url('/getting-started/telegram-bot-setup/') },
      { title: 'Configuration & Environment', href: url('/getting-started/configuration/') },
      { title: 'Verifying Installation', href: url('/getting-started/verification/') },
    ],
  },
  {
    category: 'Features & Capabilities',
    items: [
      { title: 'Feature Catalog Overview', href: url('/features/') },
      { title: 'Automated Forwarding Modes', href: url('/features/automated-forwarding/') },
      { title: 'Destination & Rules Management', href: url('/features/rules-and-destinations/') },
      { title: 'Text Cleaner (URL, Mention, Tag)', href: url('/features/text-cleaner/') },
      { title: 'Whitelist, Blacklist & Filters', href: url('/features/whitelist-blacklist-filters/') },
      { title: 'Header & Footer Shortcodes', href: url('/features/headers-footers-shortcodes/') },
      { title: 'Replacements & Regex Rules', href: url('/features/replacements-and-regex/') },
      { title: 'Scheduling & Max Time Edit', href: url('/features/scheduling-and-delays/') },
      { title: 'Media, Albums & Copy Bypass', href: url('/features/media-and-albums/') },
      { title: 'Backup, Clone & Migration', href: url('/features/backup-clone-migration/') },
      { title: 'Multi-Tenant Isolation', href: url('/features/multi-tenant-security/') },
    ],
  },
  {
    category: 'System Architecture',
    items: [
      { title: 'Architecture Overview', href: url('/architecture/') },
      { title: 'Forwarding Data Pipeline', href: url('/architecture/#pipeline') },
      { title: 'Durable Queue & Leases', href: url('/architecture/#queue') },
      { title: 'Multi-Tenant Security Model', href: url('/architecture/#security') },
    ],
  },
  {
    category: 'Tutorials & Recipes',
    items: [
      { title: 'Tutorials Overview', href: url('/tutorials/') },
      { title: 'Clean Links & Mentions', href: url('/tutorials/#cleaner') },
      { title: 'Dynamic Attribution Footers', href: url('/tutorials/#attribution') },
      { title: 'Bypass Restricted Channels', href: url('/tutorials/#restricted') },
      { title: 'Auto-Pause on FloodWait', href: url('/tutorials/#floodwait') },
    ],
  },
  {
    category: 'Operations & Support',
    items: [
      { title: 'Operations & Diagnostics', href: url('/operations/') },
      { title: 'Frequently Asked Questions', href: url('/faq/') },
      { title: 'Template Playground', href: url('/tools/playground/') },
      { title: 'Releases & Changelog', href: url('/releases/') },
    ],
  },
];

const currentPath = Astro.url.pathname;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  breadcrumbs={breadcrumbs.map(b => ({ name: b.name, url: b.href || '' }))}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    
    <!-- Top Breadcrumbs -->
    <Breadcrumbs items={breadcrumbs} />

    <div class="lg:grid lg:grid-cols-12 lg:gap-8 pt-4">
      
      <!-- Left Sidebar (Desktop Navigation) -->
      <aside class="hidden lg:block lg:col-span-3">
        <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto pr-4 space-y-7 text-sm">
          {docNav.map((sec) => (
            <div>
              <h3 class="font-semibold text-xs uppercase tracking-wider text-slate-400 mb-2.5">
                {sec.category}
              </h3>
              <ul class="space-y-1 border-l border-slate-800/80 ml-1 pl-2.5">
                {sec.items.map((it) => {
                  const isActive = currentPath === it.href || (it.href !== url('/getting-started/') && it.href !== url('/features/') && currentPath.startsWith(it.href));
                  return (
                    <li>
                      <a
                        href={it.href}
                        class={`block py-1 px-2 rounded-md transition-colors ${
                          isActive
                            ? 'font-medium text-sky-400 bg-sky-950/40 border-l-2 border-sky-400 -ml-[11px] pl-[9px]'
                            : 'text-slate-400 hover:text-slate-200 hover:bg-slate-900/60'
                        }`}
                      >
                        {it.title}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </div>
      </aside>

      <!-- Main Documentation Content -->
      <article class="lg:col-span-9 xl:col-span-7 max-w-none">
        
        <!-- Header -->
        <header class="mb-8 pb-6 border-b border-slate-800">
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white mb-3">
            {title}
          </h1>
          <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
            {description}
          </p>
        </header>

        <!-- Document Body Slot -->
        <div class="prose prose-invert prose-custom max-w-none space-y-6">
          <slot />
        </div>

        <!-- Pagination (Prev / Next) -->
        {(prev || next) && (
          <nav aria-label="Page navigation" class="mt-12 pt-6 border-t border-slate-800 grid grid-cols-1 sm:grid-cols-2 gap-4">
            {prev ? (
              <a
                href={prev.href}
                class="p-4 rounded-xl border border-slate-800 bg-slate-900/40 hover:bg-slate-800/60 transition-colors group flex flex-col items-start"
              >
                <span class="text-xs text-slate-400 font-medium flex items-center gap-1 group-hover:text-sky-400 transition-colors">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                  </svg>
                  Previous
                </span>
                <span class="font-semibold text-slate-200 mt-1 text-sm">
                  {prev.title}
                </span>
              </a>
            ) : <div />}

            {next ? (
              <a
                href={next.href}
                class="p-4 rounded-xl border border-slate-800 bg-slate-900/40 hover:bg-slate-800/60 transition-colors group flex flex-col items-end text-right"
              >
                <span class="text-xs text-slate-400 font-medium flex items-center gap-1 group-hover:text-sky-400 transition-colors">
                  Next
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
                <span class="font-semibold text-slate-200 mt-1 text-sm">
                  {next.title}
                </span>
              </a>
            ) : <div />}
          </nav>
        )}

      </article>

      <!-- Right Side: On-page TOC (Desktop XL) -->
      {toc.length > 0 && (
        <aside class="hidden xl:block xl:col-span-2">
          <div class="sticky top-24 pl-4 text-xs">
            <h4 class="font-semibold uppercase tracking-wider text-slate-400 mb-3">On this page</h4>
            <ul class="space-y-2 border-l border-slate-800 pl-3">
              {toc.map((item) => (
                <li>
                  <a
                    href={`#${item.id}`}
                    class="block text-slate-400 hover:text-sky-400 transition-colors line-clamp-2"
                  >
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )}

    </div>
  </div>
</BaseLayout>
