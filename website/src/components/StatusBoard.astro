---
import Icon from './Icon.astro';
import { url } from '../utils/paths';
import repoInfo from '../data/repo-info.json';

/**
 * The implemented / partial / planned board.
 *
 * The counts and the entries come from `docs/feature_catalog.json`, which the
 * build ingests into repoInfo.featureCatalogDetail. Nothing about a feature's
 * status is written by hand here: if the catalog says PARTIALLY_IMPLEMENTED, the
 * site says partial. That is the whole point of the component.
 */
const detail = repoInfo.featureCatalogDetail ?? [];
const counts = repoInfo.featureCatalogStatus ?? { implemented: 0, partial: 0, planned: 0 };

const buckets = [
  { key: 'implemented', label: 'Implemented', chip: 'status-chip--ok', count: counts.implemented },
  { key: 'partial', label: 'Partial', chip: 'status-chip--partial', count: counts.partial },
  { key: 'planned', label: 'Planned', chip: 'status-chip--planned', count: counts.planned },
] as const;

const entriesFor = (bucket: string) => detail.filter((entry: any) => entry.bucket === bucket);
const byBucket = Object.fromEntries(buckets.map((b) => [b.key, entriesFor(b.key)]));
---

<section class="section" id="status">
  <div class="container-x">
    <header class="max-w-2xl mb-7 reveal">
      <p class="micro mb-2">Honest status</p>
      <h2 class="display-2 text-white mb-3">What is done, what is partial, what is not built</h2>
      <p class="lede m-0">
        Every row below is read from the repository's own feature catalog at build time — {detail.length} catalogued
        capabilities with their completion condition and the entry points that implement them. Nothing on this page is
        asserted by the website.
      </p>
    </header>

    <div class="grid gap-3 grid-cols-1 sm:grid-cols-3 mb-6">
      {
        buckets.map((bucket) => (
          <div class="panel panel--lit panel--flush reveal">
            <div class="flex items-center justify-between gap-3">
              <span class={`status-chip ${bucket.chip}`}>{bucket.label}</span>
              <span class="tabular text-2xl font-extrabold text-white">{bucket.count}</span>
            </div>
            <p class="mt-3 mb-0 text-[12.5px] leading-relaxed text-slate-400">
              {byBucket[bucket.key].length} of {detail.length} catalogued capabilities
            </p>
          </div>
        ))
      }
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
      {
        buckets.map((bucket) => (
          <div class="panel panel--flush reveal">
            <div class="flex items-center gap-2 mb-3">
              <span class={`status-chip ${bucket.chip}`}>{bucket.label}</span>
              <span class="text-[12px] text-slate-500">{byBucket[bucket.key].length} entries</span>
            </div>
            {bucket.key === 'implemented' ? (
              <ul class="list-none p-0 m-0 grid gap-2">
                {byBucket[bucket.key].map((entry: any) => (
                  <li class="flex items-start gap-2 text-[13px] leading-relaxed">
                    <Icon name="check" class="w-3.5 h-3.5 mt-0.5 text-emerald-400 shrink-0" strokeWidth={2.6} />
                    <span class="text-slate-200">
                      {entry.name}
                      {entry.clients.length > 0 && (
                        <span class="block font-mono text-[11px] text-slate-500">
                          clients: {entry.clients.join(' · ')}
                        </span>
                      )}
                    </span>
                  </li>
                ))}
              </ul>
            ) : (
              <ul class="list-none p-0 m-0 grid gap-3">
                {byBucket[bucket.key].map((entry: any) => (
                  <li>
                    <p class="m-0 text-[13px] font-semibold text-slate-100">{entry.name}</p>
                    <p class="m-0 mt-1 text-[12.5px] leading-relaxed text-slate-400">
                      {entry.completionCondition ||
                        `Tracked in the catalog as ${entry.status} with an entry point that does not exist yet.`}
                    </p>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>

    <div class="mt-5 flex flex-wrap items-center gap-3 reveal">
      <a href={url('/status/')} class="btn btn-primary btn-sm btn-sheen">
        <Icon name="list" class="w-4 h-4" />
        Full status board
      </a>
      <a href={url('/releases/')} class="btn btn-secondary btn-sm">Release notes</a>
      <p class="m-0 text-[12px] text-slate-500">
        Generated from <code>docs/feature_catalog.json</code> on every build.
      </p>
    </div>
  </div>
</section>
