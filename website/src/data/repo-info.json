  "apiGroups": [
    {
      "group": "System & readiness",
      "endpoints": [
        [
          "GET",
          "/api/system/setup",
          "Ready verdict, version, env contract and live service probes (booleans only)"
        ],
        [
          "GET",
          "/api/system/setup?probe=0",
          "The same verdict without probing the services"
        ],
        [
          "GET",
          "/api/system/env",
          "Configuration contract: every key with set:true/false and a fix hint"
        ],
        [
          "GET",
          "/api/health/services",
          "Per-service reachability, latency and detail (core / logger / api / web)"
        ],
        [
          "GET",
          "/healthz",
          "Liveness probe used by the gateway and the upgrade gate"
        ]
      ]
    },
    {
      "group": "Tasks & rules",
      "endpoints": [
        [
          "GET",
          "/api/v1/rules",
          "List the caller's tasks (tenant-scoped)"
        ],
        [
          "POST",
          "/api/v1/rules",
          "Create a task with a source list, a target list and a content policy"
        ],
        [
          "GET",
          "/api/v1/rules/{id}",
          "Read one task including its resolved settings"
        ],
        [
          "PUT",
          "/api/v1/rules/{id}",
          "Update a task (optimistic concurrency, version bumped)"
        ],
        [
          "DELETE",
          "/api/v1/rules/{id}",
          "Delete a task and its schedules"
        ],
        [
          "POST",
          "/api/v1/rules/{id}/pause",
          "Pause a task: queued jobs defer instead of failing"
        ],
        [
          "POST",
          "/api/v1/rules/{id}/resume",
          "Resume a task and unblock retry-wait jobs"
        ]
      ]
    },
    {
      "group": "Sessions",
      "endpoints": [
        [
          "GET",
          "/api/v1/sessions",
          "List the caller's Telegram sessions"
        ],
        [
          "POST",
          "/api/v1/sessions/backup",
          "Export an encrypted session backup"
        ],
        [
          "POST",
          "/api/v1/sessions/restore",
          "Restore a session from an encrypted backup"
        ],
        [
          "DELETE",
          "/api/v1/sessions/{id}",
          "Terminate a session and purge its credentials"
        ]
      ]
    },
    {
      "group": "Filters & AI",
      "endpoints": [
        [
          "GET",
          "/api/v1/filters",
          "List filter rules"
        ],
        [
          "POST",
          "/api/v1/filters",
          "Create a filter rule"
        ],
        [
          "PUT",
          "/api/v1/filters/{id}",
          "Update a filter rule"
        ],
        [
          "DELETE",
          "/api/v1/filters/{id}",
          "Delete a filter rule"
        ],
        [
          "GET",
          "/api/v1/ai",
          "List AI rewrite configurations"
        ],
        [
          "POST",
          "/api/v1/ai",
          "Create an AI configuration (provider, model, prompts)"
        ],
        [
          "POST",
          "/api/v1/ai/{id}/test",
          "Test a configuration against live or sample text"
        ]
      ]
    },
    {
      "group": "Observability",
      "endpoints": [
        [
          "GET",
          "/api/v1/logs?service=&level=&search=&limit=&since=",
          "Query attributable log history with bounded paging"
        ],
        [
          "GET",
          "/api/v1/logs/stats",
          "Aggregate counts by service and level"
        ],
        [
          "POST",
          "/api/v1/logs/purge",
          "Purge log history for the caller's scope"
        ],
        [
          "GET",
          "/api/v1/delivery/stats",
          "Delivery throughput and outcome counters"
        ],
        [
          "POST",
          "/api/v1/delivery/dlq/{id}/replay",
          "Replay a dead-lettered job"
        ]
      ]
    }
  ],
