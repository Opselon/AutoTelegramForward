FROM golang:1.27.2-alpine AS builder

WORKDIR /build
COPY api/go.mod api/go.sum ./
RUN --mount=type=cache,id=atf-api-go-mod,target=/go/pkg/mod go mod download

COPY api/ .
# Module and build caches are mounted, so a source-only change reuses every
# compiled dependency package instead of rebuilding the Go standard library
# dependencies from scratch.
RUN --mount=type=cache,id=atf-api-go-mod,target=/go/pkg/mod \
    --mount=type=cache,id=atf-api-go-build,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -ldflags="-s -w" -o /atf-api .

FROM alpine:3.20
# Retry: dl-cdn.alpinelinux.org intermittently returns transient network
# errors mid-build ("temporary error (try again later)"), which fails the
# whole CI run for no code reason. Retry the install a few times instead.
RUN for i in 1 2 3 4 5; do \
      apk add --no-cache ca-certificates && break || \
      { echo "apk attempt $i failed, retrying..."; sleep 10; }; \
    done && apk info -e ca-certificates
COPY --from=builder /atf-api /usr/local/bin/atf-api
# The public /api/version endpoint reads its product version from this
# file (the CLI does the same from the repo root). Without it the shipped
# API answered "dev" to a question the mobile client displays.
COPY VERSION /etc/atf/VERSION
# The machine-readable API contract ships with the binary that serves it:
# GET /api/openapi.yaml returns exactly this document (no second copy in the
# website can drift from it).
COPY docs/openapi.yaml /etc/atf/openapi.yaml

EXPOSE 8080
ENV ATF_CORE_GRPC=core:50051 \
    ATF_API_ADDR=:8080 \
    ATF_VERSION_FILE=/etc/atf/VERSION

CMD ["atf-api"]
