---
import Icon from './Icon.astro';
import repoInfo from '../data/repo-info.json';
import { url } from '../utils/paths';

const cloneLine = `git clone ${repoInfo.repoUrl}.git && cd AutoTelegramForward`;

const tabs = [
  {
    id: 'tab-docker',
    label: 'Docker',
    blurb: 'Four containers — core, logger, api, web — behind one compose file.',
    code: `# v${repoInfo.version} — guided install (recommended)
${cloneLine}
./scripts/setup.sh

# Manual compose path
cp .env.example .env      # add your bot token + admin id
docker compose up -d
docker compose ps         # core, logger, api, web`,
    copy: `${cloneLine}\n./scripts/setup.sh`,
    href: url('/getting-started/docker/'),
    linkLabel: 'Docker guide',
  },
  {
    id: 'tab-linux',
    label: 'Linux / macOS',
    blurb: 'Installer or wizard, then a systemd service that survives reboots.',
    code: `# One-line installer
curl -sSL ${repoInfo.repoUrl.replace('https://github.com/', 'https://raw.githubusercontent.com/')}/master/install.sh | bash

# Or the interactive wizard
${cloneLine}
./scripts/setup.sh
atf status                # live board with ports + reachability`,
    copy: `curl -sSL ${repoInfo.repoUrl.replace('https://github.com/', 'https://raw.githubusercontent.com/')}/master/install.sh | bash`,
    href: url('/getting-started/linux-windows/'),
    linkLabel: 'Linux guide',
  },
  {
    id: 'tab-windows',
    label: 'Windows',
    blurb: 'PowerShell installer, then the same wizard and the same CLI.',
    code: `# PowerShell, no prerequisites beyond Python
irm ${repoInfo.repoUrl.replace('https://github.com/', 'https://raw.githubusercontent.com/')}/master/install.ps1 | iex

# Or bootstrap a checkout
git clone ${repoInfo.repoUrl}.git; cd AutoTelegramForward
python scripts\\bootstrap.py
atf status`,
    copy: `irm ${repoInfo.repoUrl.replace('https://github.com/', 'https://raw.githubusercontent.com/')}/master/install.ps1 | iex`,
    href: url('/getting-started/linux-windows/'),
    linkLabel: 'Windows guide',
  },
  {
    id: 'tab-source',
    label: 'From source',
    blurb: 'Virtualenv, requirements, then run the services yourself.',
    code: `${cloneLine}
python3 -m venv .venv && source .venv/bin/activate
pip install -r requirements.txt
python3 -m core.main        # Python core on :50051
atf validate --strict       # layout, env, compose, catalog parity`,
    copy: `${cloneLine}\npython3 -m venv .venv && source .venv/bin/activate\npip install -r requirements.txt`,
    href: url('/getting-started/'),
    linkLabel: 'Install overview',
  },
];
---

<div class="card !p-0 overflow-hidden shadow-2xl">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between px-4 py-3 border-b border-slate-800">
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
      <span class="ml-2 font-mono text-xs text-slate-400">install · v{repoInfo.version}</span>
    </div>

    <div role="tablist" aria-label="Install method" class="flex gap-1 overflow-x-auto -mx-1 px-1 pb-0.5">
      {
        tabs.map((tab, index) => (
          <button
            type="button"
            role="tab"
            class="tab-btn"
            data-target={tab.id}
            aria-controls={tab.id}
            aria-selected={index === 0 ? 'true' : 'false'}
          >
            {tab.label}
          </button>
        ))
      }
    </div>
  </div>

  {
    tabs.map((tab, index) => (
      <div id={tab.id} class="tab-content" role="tabpanel" data-tab-panel data-active={index === 0 ? 'true' : 'false'}>
        <div class="relative group">
          <pre class="quickstart-pre"><code>{tab.code}</code></pre>
          <button
            type="button"
            class="copy-code-btn absolute top-3 right-3 px-2.5 py-1.5 text-xs font-medium rounded-md bg-slate-800/90 text-slate-300 hover:text-white border border-slate-700"
            data-code={tab.copy}
            aria-label={`Copy the ${tab.label} install commands`}
          >
            Copy
          </button>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 text-xs text-slate-400 border-t border-slate-800">
          <span class="inline-flex items-center gap-2">
            <Icon name="check" class="w-3.5 h-3.5 text-emerald-400" strokeWidth={2.4} />
            {tab.blurb}
          </span>
          <a href={tab.href} class="link-inline">
            {tab.linkLabel}
            <Icon name="arrow-right" class="w-3 h-3" />
          </a>
        </div>
      </div>
    ))
  }
</div>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab-btn'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.tab-content'));

  const activate = (target: string | null) => {
    buttons.forEach((button) => {
      const on = button.dataset.target === target;
      button.classList.toggle('is-active', on);
      button.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    panels.forEach((panel) => {
      const on = panel.id === target;
      panel.dataset.active = on ? 'true' : 'false';
      panel.hidden = !on;
    });
  };

  buttons.forEach((button) => {
    button.addEventListener('click', () => activate(button.dataset.target ?? null));
  });

  document.querySelectorAll<HTMLButtonElement>('.copy-code-btn').forEach((button) => {
    button.addEventListener('click', async () => {
      const code = button.dataset.code ?? '';
      const original = button.textContent ?? 'Copy';
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Press ⌘C';
      }
      setTimeout(() => {
        button.textContent = original;
      }, 2000);
    });
  });
</script>
