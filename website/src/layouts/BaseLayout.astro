---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import SEO from '../components/SEO.astro';
import '../styles/global.css';

interface HowToStep {
  name: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: 'website' | 'article';
  breadcrumbs?: Array<{ name: string; url: string }>;
  articleDate?: string;
  articleModified?: string;
  keywords?: string[];
  faq?: Array<{ q: string; a: string }>;
  howTo?: { name: string; description: string; steps: HowToStep[] };
  itemList?: { name: string; items: Array<{ name: string; description: string; url: string }> };
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  type = 'website',
  breadcrumbs,
  articleDate,
  articleModified,
  keywords,
  faq,
  howTo,
  itemList,
  noindex,
} = Astro.props;

const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='6' fill='%230b1120'/%3E%3Cpath d='M13 3.5 5.5 14H11l-1 6.5L18.5 10H13l1-6.5z' fill='%2338bdf8'/%3E%3C/svg%3E";
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/assets/og-image.png`} />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      type={type}
      breadcrumbs={breadcrumbs}
      articleDate={articleDate}
      articleModified={articleModified}
      keywords={keywords}
      faq={faq}
      howTo={howTo}
      itemList={itemList}
      noindex={noindex}
    />
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col antialiased selection:bg-sky-500 selection:text-white">
    <Header />
    <main id="main" class="flex-grow">
      <slot />
    </main>
    <Footer />
    <BottomNav />
  </body>
</html>
