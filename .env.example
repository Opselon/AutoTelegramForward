# Copy to .env and fill in — used by docker-compose
ATF_API_ID=17349
ATF_API_HASH=344583e45741c457fe1862106095a5eb
ATF_BOT_TOKEN=123456:ABC-your-bot-token
ADMIN_USER_ID=5094837833
ADMIN_IDS=5094837833
ATF_MASTER_KEY=generate-a-long-random-string-here
ATF_API_KEY=optional-rest-api-key

# Session signing key (HS256).  Optional: leave it unset and the core generates a
# random key on first use and stores it in the database — the right default for a
# single deployment.  Set it (32+ random bytes, e.g. `openssl rand -hex 32`) when
# several deployments must accept each other's sessions, and change it to
# invalidate every session at once.  Never put a placeholder or a value copied
# from a repository here: anyone who can read it can mint a session for any
# account.  A short or placeholder value is refused at startup.
# ATF_JWT_SECRET=

# A tenant may point its rewrite config at an endpoint of its own. An address
# the server must not be made to call — loopback, link-local (cloud metadata),
# or a name resolving into this host's own networks — is refused when the key is
# checked and again when the config is stored. Set this to 1 only when the AI
# provider is a peer of the stack on a private network the operator controls
# (e.g. the bundled 9router service); loopback and cloud metadata stay refused.
# ATF_ALLOW_PRIVATE_AI_ENDPOINTS=1

# Public URL the dashboard/gateway advertises for this deployment (used by the
# web container and by health checks that need the external address).
ATF_WEB_URL=http://localhost:8088

# --- Diagnostic raw MTProto tracing (off unless you are debugging the wire)
# When set to 1, the Core logs a bounded, single-line summary of every Telegram
# request/response to the container log. Credentials (access_hash,
# file_reference, tokens) are masked, but the volume is high: a busy account can
# produce tens of thousands of lines an hour. Leave it unset in production.
# ATF_RAW_API_TRACE=1

# --- Button styles (keyboardButtonStyle) ---
# Panels render Save as green, destructive actions as red and main actions as
# blue. Set to 0 to force plain buttons (the UI also falls back by itself the
# first time a styled keyboard is rejected, so this is only for a permanent
# opt-out). ATF_BUTTON_STYLE_PROBE=<chat id> sends one styled message through
# the live client at boot and logs whether the server accepted it — the only
# end-to-end check that the session's layer supports the constructor. Leave it
# unset in production.
# ATF_BUTTON_STYLES=1
# ATF_BUTTON_STYLE_PROBE=123456789

# --- Optional TLS reverse proxy (enable with: docker compose --profile tls up -d)
# ATF_TLS_DOMAIN points Caddy at your domain; it provisions a Let's Encrypt
# certificate automatically. ATF_TLS_EMAIL is used for ACME account registration.
ATF_TLS_DOMAIN=panel.example.com
ATF_TLS_EMAIL=admin@example.com

# --- Shared Redis (rate limiting + worker coordination) --------------------
# The API enforces the request quotas (ATF_RATELIMIT_* below) through this
# store and the Core coordinates its singleton loops through it, so ONE
# variable configures the deployment; "redis" is the service name in
# docker-compose.yml. Generated automatically for you in a fresh install.
#
# SECURITY: set a password (`openssl rand -hex 24`) and never commit it. The
# compose service listens only on the stack's internal network, and its health
# probe uses the same value:
#   ATF_REDIS_PASSWORD=...
#
# To run WITHOUT Redis entirely (single replica, per-process limits):
#   1. remove/at least do not start the redis service, AND
#   2. set ATF_REDIS_ADDR= (empty). Deleting only the service would leave the
#      API pointing at an address that no longer exists, and the
#      authentication endpoints refuse requests while their limit cannot be
#      enforced — that is deliberate, not a bug.
ATF_REDIS_ADDR=redis:6379
# ATF_REDIS_PASSWORD=
# Memory ceiling of the limit/lease store; the allocation policy is pinned on
# purpose (see docs/redis.md), so only the size is configurable here.
# ATF_REDIS_MAXMEMORY=256mb
# ATF_REDIS_MAXMEMORY_POLICY=noeviction

# --- Public API rate limits ------------------------------------------------
# Sustained request budgets per minute; the first number is what a client may
# average, ATF_RATELIMIT_<CLASS>_BURST is what it may spend in one go.
#
#   class  what it covers                                 default (rate / burst)
#   auth   unauthenticated login/register/auth-exchange   30   / 10
#   shield everything reachable before the token is verified  600 / 120
#   read   authenticated GET                              600  / 120
#   write  authenticated POST/PUT/PATCH/DELETE            120  / 30
#   admin  /api/admin/*                                   300  / 60
#   probe  /healthz, /api/version, ...                    1200 / 300
#
# When the store cannot answer a class behaves per its fail mode:
#   closed — the endpoint refuses (503): login/register, the pre-auth shield
#   local  — enforced per process (degraded, and reported as degraded)
#   open   — unmeasured: available, deliberately not a default anywhere
#   (auth=closed shield=closed read=local write=local admin=local probe=local)
# ATF_RATELIMIT_AUTH_PER_MINUTE=30
# ATF_RATELIMIT_AUTH_BURST=10
# ATF_RATELIMIT_AUTH_FAIL_MODE=closed
# ATF_RATELIMIT_READ_PER_MINUTE=600
# ATF_RATELIMIT_WRITE_PER_MINUTE=120
# Algorithm: tb (token bucket, exact ceiling) or sw (bucketed sliding window,
# ~10% coarse at a bucket boundary; see docs/benchmarks/redis-ratelimit.md).
# ATF_RATELIMIT_ALGO=tb

# Behind a reverse proxy? Declare it, or every client behind it shares ONE
# limit bucket (they are attributed to the proxy's address):
# ATF_TRUSTED_PROXIES=10.0.0.0/8

# --- Authoritative PostgreSQL Database (Production Hardening)
# ATF_DATABASE_URL=postgresql://atf:atf_secure_password@postgres:5432/atf_db
# ATF_POSTGRES_ALL=1
