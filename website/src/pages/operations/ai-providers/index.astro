const examples = [
  {
    label: 'Prove a key, then store the config',
    content: `# 1. What this deployment can call, and the model families it quotes
curl -s https://your-host/api/ai-configs/providers -H "Authorization: Bearer $TOKEN" | jq '.providers[] | {id, label, models}'

# 2. Probe the credential. Nothing is written by this call.
curl -s -X POST https://your-host/api/ai-configs/check-key -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json' -d '{"provider":"openai","model":"gpt-4o-mini","api_key":"sk-…"}' | jq
